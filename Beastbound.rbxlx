local function rebuildAreas()
	if not S.data then return end
	for _, c in ipairs(aScroll:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	for i, a in ipairs(Config.Areas) do
		local unlocked = S.data.areas[tostring(i)] == true
