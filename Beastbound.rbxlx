		label(row, unlocked and "Unlocked ✔  |  " .. Config.Eggs[a.egg].display or ("🪙 " .. S.fmt(a.cost) .. (i > 1 and not S.data.areas[tostring(i - 1)] and "  (needs previous)" or "")), 14, unlocked and pal.good or pal.acc, {Position = UDim2.fromOffset(10, 28), Size = UDim2.new(0.6, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13})
		if unlocked then
			button(row, "Teleport", pal.good, UDim2.fromOffset(110, 36), UDim2.new(1, -120, 0, 10), function() S.invoke("Teleport", i) UI.close() end, {TextSize = 17, ZIndex = 13})
		else
			button(row, "Unlock", pal.acc, UDim2.fromOffset(110, 36), UDim2.new(1, -120, 0, 10), function() S.invoke("UnlockArea", i) end, {TextSize = 17, ZIndex = 13, TextColor3 = Color3.new(0, 0, 0)})
		end
	end
end
UI.onOpen("Areas", rebuildAreas)

---------------------------------------------------------------- settings
local setF = UI.panel("Settings", 420, 300, "⚙️ Settings")
UI.hideOthers = false
local function slider(y, text, key, onChange)
	label(setF, text, 18, Color3.new(1, 1, 1), {Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(120, 30), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12})
	local bar = mk("Frame", {Parent = setF, Position = UDim2.fromOffset(150, y + 8), Size = UDim2.fromOffset(240, 14), BackgroundColor3 = pal.bg, ZIndex = 12})
	round(bar, 7)
	local fill = mk("Frame", {Parent = bar, Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = pal.acc, ZIndex = 13})
	round(fill, 7)
	local knob = mk("Frame", {Parent = bar, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 14})
	round(knob, 11) stroke(knob)
	local dragging = false
	local function set(frac)
		frac = math.clamp(frac, 0, 1)
		fill.Size = UDim2.fromScale(frac, 1)
		knob.Position = UDim2.fromScale(frac, 0.5)
		if S.data then S.data.settings[key] = frac end
		onChange(frac)
	end
	local hit = mk("TextButton", {Parent = bar, Size = UDim2.new(1, 0, 3, 0), Position = UDim2.fromScale(0, -1), BackgroundTransparency = 1, Text = "", ZIndex = 15})
	local function upd(input) set((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X) end
	hit.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true upd(i) end end)
	UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end end)
	UIS.InputEnded:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			S.invoke("SetSetting", key, S.data and S.data.settings[key] or 0.5)
		end
	end)
	return set
end
local setMusic = slider(60, "🎵 Music", "music", function(v) S.emit("MusicVolume", v) end)
local setSfx = slider(110, "🔊 Effects", "sfx", function() end)
local othersBtn
othersBtn = button(setF, "Other players' pets: ON", pal.good, UDim2.fromOffset(260, 40), UDim2.fromOffset(80, 165), function(b)
	UI.hideOthers = not UI.hideOthers
	b.Text = "Other players' pets: " .. (UI.hideOthers and "OFF" or "ON")
	b.BackgroundColor3 = UI.hideOthers and pal.bad or pal.good
end, {TextSize = 17, ZIndex = 12})
label(setF, "Tap an enemy to send your pets to fight it.\nHatch eggs at the main spawn!", 15, pal.dim, {Position = UDim2.fromOffset(20, 220), Size = UDim2.fromOffset(380, 60), ZIndex = 12})
UI.onOpen("Settings", function()
	if S.data then setMusic(S.data.settings.music) setSfx(S.data.settings.sfx) end
end)

---------------------------------------------------------------- announcements
local flash = mk("Frame", {Parent = root, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = 90, Active = false})
function UI.flash(color, t)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 0.2
	TS:Create(flash, TweenInfo.new(t or 0.8), {BackgroundTransparency = 1}):Play()
end

local banner = mk("Frame", {Parent = root, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -120), Size = UDim2.fromOffset(640, 90), BackgroundColor3 = Color3.fromRGB(120, 10, 20), ZIndex = 80, Visible = false})
round(banner, 16) stroke(banner, Color3.fromRGB(255, 215, 70), 4)
mk("UIGradient", {Parent = banner, Color = ColorSequence.new(Color3.fromRGB(255, 60, 40), Color3.fromRGB(110, 0, 120))})
local bTitle = label(banner, "", 30, Color3.fromRGB(255, 230, 100), {Size = UDim2.new(1, -20, 0.5, 0), Position = UDim2.fromOffset(10, 4), ZIndex = 81, TextStrokeTransparency = 0})
local bText = label(banner, "", 24, Color3.new(1, 1, 1), {Size = UDim2.new(1, -20, 0.5, 0), Position = UDim2.new(0, 10, 0.5, -2), ZIndex = 81, TextStrokeTransparency = 0})
local bannerToken = 0
function UI.banner(title, text, c1, c2, dur)
	bannerToken = bannerToken + 1
	local tok = bannerToken
	banner.Visible = true
	banner:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(c1, c2)
	bTitle.Text = title bText.Text = text
	banner.Position = UDim2.new(0.5, 0, 0, -120)
	TS:Create(banner, TweenInfo.new(0.5, Enum.EasingStyle.Back), {Position = UDim2.new(0.5, 0, 0, 70)}):Play()
	task.delay(dur, function()
		if tok ~= bannerToken then return end
		TS:Create(banner, TweenInfo.new(0.4), {Position = UDim2.new(0.5, 0, 0, -120)}):Play()
		task.wait(0.45)
		if tok == bannerToken then banner.Visible = false end
	end)
end

S.R.Announce.OnClientEvent:Connect(function(kind, user, petDisplay, extra)
	if kind == "Titanic" then
		UI.banner("🔥 TITANIC HATCHED! 🔥", user .. " hatched the " .. petDisplay .. "!!", Color3.fromRGB(255, 70, 40), Color3.fromRGB(110, 0, 140), 9)
		UI.flash(Color3.fromRGB(255, 220, 120), 1.6)
		S.sfx("Titanic", 1, 0.6)
		S.sfx("Rare", 0.8, 0.8)
		S.shakeAmp = math.max(S.shakeAmp, 1.2)
	else
		local c = Config.Rarities[extra] and Config.Rarities[extra].color or Color3.new(1, 1, 1)
		UI.banner("✨ " .. string.upper(extra) .. " HATCH ✨", user .. " hatched " .. petDisplay, c:Lerp(Color3.new(0, 0, 0), 0.45), c:Lerp(Color3.new(0, 0, 0), 0.7), 5)
		S.sfx("Rare", 0.5)
	end
end)

---------------------------------------------------------------- data hooks
S.on("Data", function(d)
	setCoins(d.coins)
	refreshEq()
	if UI.isOpen("Inventory") then rebuildInv() end
	if UI.isOpen("Areas") then rebuildAreas() end
	if UI.isOpen("Index") then rebuildIndex() end
end)

-- riding buttons (dismount + fly up/down for touch)
local rideFrame = mk("Frame", {Parent = root, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -90), Size = UDim2.fromOffset(170, 190), BackgroundTransparency = 1, Visible = false})
UI.rideUp = button(rideFrame, "▲ UP", pal.blue, UDim2.fromOffset(160, 50), UDim2.fromOffset(0, 0), nil, {TextSize = 22})
UI.rideDown = button(rideFrame, "▼ DOWN", pal.blue, UDim2.fromOffset(160, 50), UDim2.fromOffset(0, 58), nil, {TextSize = 22})
button(rideFrame, "Dismount (F)", pal.bad, UDim2.fromOffset(160, 50), UDim2.fromOffset(0, 124), function() S.invoke("Ride", "") end, {TextSize = 20})
function UI.showRide(on, flying)
	rideFrame.Visible = on
	UI.rideUp.Visible = flying and true or false
	UI.rideDown.Visible = flying and true or false
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Pets</string><ProtectedString name="Source"><![CDATA[-- Pets (ModuleScript) | StarterPlayerScripts.Client.Pets
-- Every client renders every player's equipped creatures locally (smooth, cheap, no server replication cost).
local S = require(script.Parent.Shared)
local UI = require(script.Parent.UI)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config, MB = S.Config, S.MB
local Pets = {}

local folder = Instance.new("Folder")
folder.Name = "ClientPets"
folder.Parent = workspace
local state = {}
local camera = workspace.CurrentCamera

local function angleLerp(a, b, t)
	local d = (b - a + math.pi) % (math.pi * 2) - math.pi
	return a + d * t
end

local function newRig(name)
	local rig = MB.Pet(name)
	rig.model.PrimaryPart.Anchored = true
	rig.pos = nil
	rig.yaw = 0
	rig.lunge = -10
	rig.lastStep = 0
	rig.flapT = 0
	rig.name = name
	rig.drop = rig.model:GetAttribute("Drop") or 2
	return rig
end

local function destroyState(st)
	for _, p in ipairs(st.pets) do p.model:Destroy() end
	if st.mount then st.mount.model:Destroy() end
	st.pets = {}
	st.mount = nil
end

local function stomp(rig, pos)
	local d = (camera.CFrame.Position - pos).Magnitude
	local f = math.clamp(1 - d / 260, 0, 1)
	if f <= 0 then return end
	S.shakeAmp = math.max(S.shakeAmp, f * math.clamp(rig.scale / 11, 0.1, 1) * 0.9)
	S.sfx("Stomp", 0.55 * f, 0.55 + math.random() * 0.15, pos)
	S.burst(pos + Vector3.new(math.random(-3, 3) * rig.scale * 0.2, 0.5, math.random(-3, 3) * rig.scale * 0.2), Color3.fromRGB(190, 170, 140), 12, rig.scale * 0.25, rig.scale * 1.2, 1)
end

-- moves one rig toward a target with smoothing, animates it
local function drive(rig, target, faceYaw, dt, rate, attack, flying)
	local root = rig.model.PrimaryPart
	if not rig.pos then rig.pos = target rig.last = target end
	rig.pos = rig.pos:Lerp(target, 1 - math.exp(-dt * rate))
	local delta = rig.pos - rig.last
	local speed = Vector3.new(delta.X, 0, delta.Z).Magnitude / math.max(dt, 1e-3)
	rig.last = rig.pos
	if speed > 2.5 and not rig.fixedYaw then
		rig.yaw = angleLerp(rig.yaw, math.atan2(-delta.X, -delta.Z), 1 - math.exp(-dt * 6))
	else
		rig.yaw = angleLerp(rig.yaw, faceYaw, 1 - math.exp(-dt * 5))
	end
	root.CFrame = CFrame.new(rig.pos) * CFrame.Angles(0, rig.yaw, 0)
	MB.Animate(rig, dt, speed, flying or false, attack)
	if rig.titanic and rig.kind ~= "dragon" and speed > 3 then
		local st = math.floor(rig.phase / math.pi)
		if st ~= rig.lastStep then
			rig.lastStep = st
			stomp(rig, rig.pos - Vector3.new(0, rig.drop, 0))
		end
	end
	if rig.titanic and rig.kind == "dragon" then
		rig.flapT = rig.flapT + dt
		if rig.flapT > 1.3 then
			rig.flapT = 0
			if (camera.CFrame.Position - rig.pos).Magnitude < 300 then S.sfx("Flap", 0.5, 0.5, rig.pos) end
		end
	end
	return speed
end

local function process(plr, dt)
	local st = state[plr]
	if not st then
		st = {key = "", pets = {}}
		state[plr] = st
	end
	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local eq = plr:GetAttribute("Equipped") or ""
	local riding = plr:GetAttribute("Riding")
	local hide = (UI.hideOthers and plr ~= S.player) or not hrp or not hum or hum.Health <= 0
	local key = (hide and "hidden") or (eq .. "|" .. (riding or ""))
	if key ~= st.key then
		destroyState(st)
		st.key = key
		if not hide then
			for name in string.gmatch(eq, "[^,]+") do
				if Config.Pets[name] then
					local rig = newRig(name)
					rig.model.Parent = folder
					table.insert(st.pets, rig)
				end
			end
			if riding and Config.Pets[riding] then
				local rig = newRig(riding)
				rig.fixedYaw = true
				rig.model.Parent = folder
				st.mount = rig
			end
		end
	end
	if hide then return end

	local gy = S.groundY(char)
	local look = hrp.CFrame.LookVector
	local ownerYaw = math.atan2(-look.X, -look.Z)
	local base = hrp.Position
	local tv = plr:FindFirstChild("Target")
	local enemy = tv and tv.Value
	local fighting = enemy and enemy.Parent and not enemy:GetAttribute("Dead")
	local center, eradius
	if fighting then
		center = enemy:GetPivot().Position
		eradius = enemy:GetAttribute("Radius") or 5
	end
	-- mount
	if st.mount then
		local m = st.mount
		if m.kind == "dragon" then
			local saddle = m.model:GetAttribute("Saddle") or 4
			local cf = hrp.CFrame * CFrame.new(0, -3 - saddle, 0)
			m.pos = cf.Position
			m.model.PrimaryPart.CFrame = cf
			MB.Animate(m, dt, hrp.AssemblyLinearVelocity.Magnitude, true, 0)
			m.flapT = m.flapT + dt
			if m.flapT > 0.9 then m.flapT = 0 if plr == S.player then S.sfx("Flap", 0.45, 0.5) end end
		else
			local vel = hrp.AssemblyLinearVelocity
			local pos = Vector3.new(base.X, gy + m.drop, base.Z)
			m.pos, m.last = pos, m.last or pos
			local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
			m.yaw = angleLerp(m.yaw, ownerYaw, 1 - math.exp(-dt * 8))
			m.model.PrimaryPart.CFrame = CFrame.new(pos) * CFrame.Angles(0, m.yaw, 0)
			MB.Animate(m, dt, speed, false, 0)
			if speed > 3 then
				local stp = math.floor(m.phase / math.pi)
				if stp ~= m.lastStep then m.lastStep = stp stomp(m, pos - Vector3.new(0, m.drop, 0)) end
			end
		end
	end
	-- followers
	local normal, n = {}, 0
	for i, rig in ipairs(st.pets) do
		if riding and rig.name == riding then
			rig.model.Parent = nil
		else
			if rig.model.Parent ~= folder then rig.model.Parent = folder end
			if not rig.titanic then n = n + 1 normal[rig] = n end
		end
	end
	for i, rig in ipairs(st.pets) do
		if rig.model.Parent == folder then
			local attack = 0
			local tgt
			local face = ownerYaw
			local hover = 0
			if rig.kind == "dragon" then hover = rig.scale < 3 and (1.2 + rig.scale * 0.9 + math.sin(os.clock() * 2 + i) * 0.35) or (rig.scale * 0.22 + 3) end
			if fighting then
				local ang = (i / math.max(#st.pets, 1)) * math.pi * 2 + 0.6
				local dist = eradius + rig.scale * (rig.titanic and 3.2 or 2.2) + 3
				local p2 = Vector3.new(center.X + math.cos(ang) * dist, center.Y + rig.drop + hover, center.Z + math.sin(ang) * dist)
				local toE = Vector3.new(center.X - p2.X, 0, center.Z - p2.Z)
				face = math.atan2(-toE.X, -toE.Z)
				local t = os.clock() - rig.lunge
				if t < 0.32 then
					attack = math.sin(math.pi * t / 0.32)
					p2 = p2 + toE.Unit * (toE.Magnitude - eradius - rig.scale) * 0.55 * attack
				end
				tgt = p2
			else
				local slot, r
				if rig.titanic then
					slot = Vector3.new(0, 0, 10 + rig.scale * 3.4)
				else
					local k = normal[rig] or 1
					local ang = (k - (n + 1) / 2) * 0.75
					r = 6.5 + rig.scale * 2.4
					slot = Vector3.new(math.sin(ang) * r, 0, math.cos(ang) * r * 0.9 + 1.5)
				end
				local cf = CFrame.new(base) * CFrame.Angles(0, ownerYaw, 0)
				local w = cf:PointToWorldSpace(slot)
				tgt = Vector3.new(w.X, gy + rig.drop + hover, w.Z)
			end
			drive(rig, tgt, face, dt, rig.titanic and 3.2 or 7.5, attack, false)
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 0.1)
	for _, plr in ipairs(Players:GetPlayers()) do
		local ok, err = pcall(process, plr, dt)
		if not ok then warn("[pets]", err) end
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	local st = state[plr]
	if st then destroyState(st) state[plr] = nil end
end)

S.R.PetHit.OnClientEvent:Connect(function(plr, idx, enemy, dmg)
	local st = state[plr]
	if not st or not enemy or not enemy.Parent then return end
	local rig = st.pets[idx]
	if rig then rig.lunge = os.clock() end
	local pos = enemy:GetPivot().Position + Vector3.new(0, (enemy:GetAttribute("Height") or 6) * 0.5, 0)
	if plr == S.player or math.random() < 0.3 then
		S.burst(pos, rig and Color3.fromRGB(255, 240, 180) or Color3.new(1, 1, 1), 6, 1.2, 14, 0.4)
		if plr == S.player then S.sfx("Hit", 0.3, 0.9 + math.random() * 0.3, pos) end
	end
	S.emit("EnemyHit", enemy)
end)

function Pets.mountRig(plr) return state[plr] and state[plr].mount end

return Pets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">WorldClient</string><ProtectedString name="Source"><![CDATA[-- WorldClient (ModuleScript) | StarterPlayerScripts.Client.WorldClient
local S = require(script.Parent.Shared)
local UI = require(script.Parent.UI)
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TS = S.TS
local Config = S.Config
local W = {}
local Terrain = workspace.Terrain
local camera = workspace.CurrentCamera
local enemiesFolder = workspace:WaitForChild("Enemies")

---------------------------------------------------------------- enemy selection
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = {enemiesFolder}

local highlight = Instance.new("Highlight")
highlight.FillTransparency = 0.85
highlight.FillColor = Color3.fromRGB(255, 80, 80)
highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

local function enemyAt(ray)
	local r
	local ok, res = pcall(function() return workspace:Spherecast(ray.Origin, 2.5, ray.Direction * 600, rayParams) end)
	if ok then r = res else r = workspace:Raycast(ray.Origin, ray.Direction * 600, rayParams) end
	if r and r.Instance then
		local m = r.Instance:FindFirstAncestorWhichIsA("Model")
		if m and m.Parent == enemiesFolder and not m:GetAttribute("Dead") then return m end
	end
end

local function target()
	local tv = S.player:FindFirstChild("Target")
	return tv and tv.Value
end

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	local ray
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local p = UIS:GetMouseLocation()
		ray = camera:ViewportPointToRay(p.X, p.Y)
	elseif input.UserInputType == Enum.UserInputType.Touch then
		ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
	else
		return
	end
	if S.data and not S.data.starter then return end
	local m = enemyAt(ray)
	if m and m ~= target() then
		S.R.Select:FireServer(m)
		S.sfx("Click", 0.5, 1.2)
		highlight.Adornee = m
		highlight.Parent = m
	end
end)

task.spawn(function()
	local tv = S.player:WaitForChild("Target")
	tv.Changed:Connect(function(v)
		if v and v.Parent then
			highlight.Adornee = v
			highlight.Parent = v
		else
			highlight.Adornee = nil
			highlight.Parent = nil
		end
	end)
end)

---------------------------------------------------------------- idle bob + hit shake
local base = {}
local hitAt = {}
S.on("EnemyHit", function(m) hitAt[m] = os.clock() end)
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	local cp = camera.CFrame.Position
	for _, m in ipairs(enemiesFolder:GetChildren()) do
		if m:IsA("Model") and not m:GetAttribute("Dead") then
			local b = base[m]
			if not b then b = m:GetPivot() base[m] = b end
			if (b.Position - cp).Magnitude < 170 then
				local seed = (b.Position.X + b.Position.Z) * 0.1
				local off = CFrame.new(0, math.sin(t * 1.6 + seed) * 0.35, 0) * CFrame.Angles(0, math.sin(t * 0.7 + seed) * 0.08, 0)
				local h = t - (hitAt[m] or -10)
				if h < 0.18 then off = off * CFrame.new(math.random(-10, 10) / 40, 0, math.random(-10, 10) / 40) end
				m:PivotTo(b * off)
			end
		end
	end
end)

---------------------------------------------------------------- damage numbers
S.R.Damage.OnClientEvent:Connect(function(enemy, dmg)
	if not enemy or not enemy.Parent then return end
	local pos = enemy:GetPivot().Position + Vector3.new(math.random(-20, 20) / 10, (enemy:GetAttribute("Height") or 6) * 0.6, math.random(-20, 20) / 10)
	local att = Instance.new("Attachment")
	att.WorldPosition = pos
	att.Parent = Terrain
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(120, 40)
	g.AlwaysOnTop = true
	g.Adornee = att
	g.Parent = att
	local l = S.label(g, S.fmt(dmg), 26, Color3.fromRGB(255, 240, 120), {Size = UDim2.fromScale(1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(180, 70, 0)})
	g.StudsOffset = Vector3.new(0, 0, 0)
	TS:Create(g, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {StudsOffset = Vector3.new(0, 6, 0)}):Play()
	TS:Create(l, TweenInfo.new(0.8), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
	game:GetService("Debris"):AddItem(att, 1)
end)

---------------------------------------------------------------- defeat animation
S.R.Defeated.OnClientEvent:Connect(function(m)
	if not m or not m.Parent then return end
	local center = m:GetPivot().Position
	S.sfx("Defeat", 0.6, 0.9, center)
	S.burst(center + Vector3.new(0, 4, 0), Color3.fromRGB(255, 230, 150), 30, 2, 40, 0.8)
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			local dir = (p.Position - center)
			dir = (dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 1, 0)) * 10 + Vector3.new(0, 6, 0)
			local goal = {Transparency = 1, CFrame = p.CFrame * CFrame.Angles(math.random() * 3, math.random() * 3, math.random() * 3) + dir, Size = p.Size * 0.2}
			p.CanCollide = false
			TS:Create(p, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
		end
	end
	if target() == m then highlight.Parent = nil end
end)

---------------------------------------------------------------- coins flying to the player
local coins = {}
S.R.Coin.OnClientEvent:Connect(function(pos, amount)
	local n = math.clamp(4 + math.floor(math.log10(math.max(amount, 1)) * 2), 4, 16)
	for i = 1, n do
		local p = Instance.new("Part")
		p.Anchored = true p.CanCollide = false p.CanQuery = false p.CanTouch = false
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.4, 2, 2)
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 205, 40)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
		p.Parent = workspace
		coins[#coins + 1] = {part = p, t0 = os.clock() + i * 0.03, from = pos, burst = Vector3.new(math.random(-10, 10), math.random(6, 14), math.random(-10, 10)), dead = false}
	end
	-- floating +amount
	local att = Instance.new("Attachment")
	att.WorldPosition = pos + Vector3.new(0, 4, 0)
	att.Parent = Terrain
	local g = Instance.new("BillboardGui")
	g.Size = UDim2.fromOffset(200, 50) g.AlwaysOnTop = true g.Adornee = att g.Parent = att
	local l = S.label(g, "+" .. S.fmt(amount) .. " 🪙", 32, Color3.fromRGB(255, 220, 60), {Size = UDim2.fromScale(1, 1), TextStrokeTransparency = 0})
	TS:Create(g, TweenInfo.new(1.4), {StudsOffset = Vector3.new(0, 9, 0)}):Play()
	TS:Create(l, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
	game:GetService("Debris"):AddItem(att, 1.6)
	S.sfx("Coin", 0.5, 1 + math.random() * 0.3)
end)

RunService.RenderStepped:Connect(function()
	if #coins == 0 then return end
	local char = S.player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local now = os.clock()
	for i = #coins, 1, -1 do
		local c = coins[i]
		local t = now - c.t0
		if t >= 0 then
			if t < 0.35 then
				c.part.Position = c.from + c.burst * t + Vector3.new(0, -20 * t * t, 0)
			elseif hrp then
				local a = math.clamp((t - 0.35) / 0.45, 0, 1)
				local start = c.from + c.burst * 0.35 + Vector3.new(0, -20 * 0.1225, 0)
				c.part.Position = start:Lerp(hrp.Position + Vector3.new(0, 2, 0), a * a)
				if a >= 1 then c.part:Destroy() table.remove(coins, i) end
			else
				c.part:Destroy() table.remove(coins, i)
			end
		end
	end
end)

---------------------------------------------------------------- spawn eggs: locked / unlocked visuals
local stands = {}
local function findStands()
	local eggs = workspace:WaitForChild("World"):WaitForChild("Spawn"):WaitForChild("Eggs")
	for _, m in ipairs(eggs:GetChildren()) do
		local id = m:GetAttribute("EggId")
		if id then stands[id] = m end
	end
end
local function refreshWorld()
	local d = S.data
	if not d then return end
	for id, m in pairs(stands) do
		local e = Config.Eggs[id]
		local unlocked = d.areas[tostring(e.area)] == true
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("BasePart") and p.Name ~= "Sign" and p.Name ~= "Base" and p.Name ~= "Ring" then
				p.LocalTransparencyModifier = unlocked and 0 or 1
			end
		end
		local sg = m.Sign:FindFirstChild("SignGui")
		if sg then
			sg.Title.Text = unlocked and e.display or ("🔒 " .. Config.Areas[e.area].name)
			sg.Price.Text = unlocked and ("🪙 " .. S.fmt(e.price)) or "Unlock this area first"
		end
	end
	for i = 1, 10 do
		local area = workspace.World:FindFirstChild("Area" .. i)
		local barrier = area and area:FindFirstChild("Barrier")
		if barrier and d.areas[tostring(i)] then
			barrier.CanCollide = false
			barrier.Transparency = 1
			local pr = barrier:FindFirstChildOfClass("ProximityPrompt")
			if pr then pr.Enabled = false end
		end
	end
end
task.spawn(function()
	findStands()
	refreshWorld()
end)
S.on("Data", refreshWorld)

S.R.Fx.OnClientEvent:Connect(function(kind, i)
	if kind == "AreaUnlock" then
		UI.flash(Config.Areas[i].theme.glow, 1.2)
		S.sfx("Unlock", 0.8)
		UI.banner("🌍 AREA UNLOCKED!", Config.Areas[i].name .. " — new egg at spawn!", Config.Areas[i].theme.glow:Lerp(Color3.new(0, 0, 0), 0.5), Color3.fromRGB(30, 30, 60), 4)
	end
end)

---------------------------------------------------------------- area detection, lighting, nearest egg
local currentArea = -1
local nearEgg
local function lightTo(p)
	TS:Create(Lighting, TweenInfo.new(2), {Ambient = p.ambient, OutdoorAmbient = p.ambient, FogColor = p.fog, FogEnd = p.fogEnd, ClockTime = p.clock, Brightness = p.bright}):Play()
end
local spawnLight = {ambient = Color3.fromRGB(130, 135, 150), fog = Color3.fromRGB(200, 225, 255), fogEnd = 1500, clock = 14, bright = 2.6}
Lighting.FogStart = 0
lightTo(spawnLight)

task.spawn(function()
	while true do
		task.wait(0.25)
		local char = S.player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			local p = hrp.Position
			local a = 0
			for i = 1, 10 do
				local c = Config.AreaCenter(i)
				if (Vector3.new(p.X, 0, p.Z) - c).Magnitude < Config.World.AreaRadius + 10 then a = i break end
			end
			if a ~= currentArea then
				currentArea = a
				UI.setArea(a)
				lightTo(a == 0 and spawnLight or Config.Areas[a].light)
			end
			local best, bd
			for id, m in pairs(stands) do
				local d = (m.PrimaryPart.Position - p).Magnitude
				local e = Config.Eggs[id]
				if d < 22 and S.data and S.data.areas[tostring(e.area)] and (not bd or d < bd) then best, bd = id, d end
			end
			if best ~= nearEgg then
				nearEgg = best
				S.emit("NearEgg", best)
			end
		end
	end
end)

function W.nearEgg() return nearEgg end

return W
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Hatch</string><ProtectedString name="Source"><![CDATA[-- Hatch (ModuleScript) | StarterPlayerScripts.Client.Hatch
local S = require(script.Parent.Shared)
local UI = require(script.Parent.UI)
local Config, pal, mk, round, stroke, label, button = S.Config, S.pal, S.mk, S.round, S.stroke, S.label, S.button
local TS = S.TS
local H = {}

local nearEgg
local busy, auto, lastCount = false, false, 1
local snapshot = {}

S.on("Data", function(d)
	if not busy then
		snapshot = {}
		for k in pairs(d.discovered) do snapshot[k] = true end
	end
end)

---------------------------------------------------------------- egg panel
local panel = mk("Frame", {Parent = UI.root, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -84), Size = UDim2.fromOffset(500, 210), BackgroundColor3 = pal.panel, Visible = false, ZIndex = 8})
round(panel, 16) stroke(panel, Color3.fromRGB(15, 15, 30), 4)
local title = label(panel, "", 24, pal.acc, {Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -24, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9})
local odds = mk("ScrollingFrame", {Parent = panel, Position = UDim2.fromOffset(12, 40), Size = UDim2.fromOffset(270, 160), BackgroundColor3 = pal.bg, BackgroundTransparency = 0.3, ScrollBarThickness = 5, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, ZIndex = 9})
round(odds, 10)
mk("UIListLayout", {Parent = odds, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder})
local hBtns = {}
local function setPanel(eggId)
	nearEgg = eggId
	if not eggId then panel.Visible = false auto = false return end
	local e = Config.Eggs[eggId]
	panel.Visible = true
	title.Text = e.display .. "  —  🪙 " .. S.fmt(e.price)
	for _, c in ipairs(odds:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	for i, o in ipairs(e.odds) do
		local pet = Config.Pets[o[1]]
		local row = mk("Frame", {Parent = odds, Size = UDim2.new(1, -8, 0, 26), BackgroundColor3 = pet.titanic and Color3.fromRGB(110, 20, 30) or pal.panel, LayoutOrder = i, ZIndex = 10})
		round(row, 6)
		label(row, (pet.titanic and "★ " or "") .. pet.display, 15, S.rarityColor(o[1]), {Size = UDim2.new(0.62, 0, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, TextStrokeTransparency = 0.6})
		label(row, Config.OddsText(o[2]), 14, Color3.new(1, 1, 1), {Size = UDim2.new(0.38, -6, 1, 0), Position = UDim2.new(0.62, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 11})
	end
	for c, b in pairs(hBtns) do b.Text = "Hatch x" .. c .. "\n🪙 " .. S.fmt(e.price * c) end
end
S.on("NearEgg", setPanel)

---------------------------------------------------------------- overlay animation
local function eggViewport(parent, eggId)
	local theme = Config.Areas[Config.Eggs[eggId].area].theme
	local vp = mk("ViewportFrame", {Parent = parent, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = Color3.fromRGB(170, 170, 185), LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(-0.6, -0.8, -0.5)})
	local m = Instance.new("Model") m.Parent = vp
	local function ball(size, pos, color, mat)
		local p = Instance.new("Part") p.Size = size p.Position = pos p.Color = color p.Material = mat or Enum.Material.SmoothPlastic p.Anchored = true p.CanCollide = false
		local mesh = Instance.new("SpecialMesh") mesh.MeshType = Enum.MeshType.Sphere mesh.Parent = p
		p.Parent = m
		return p
	end
	ball(Vector3.new(4, 5.2, 4), Vector3.zero, theme.c2)
	for i = 1, 7 do
		local a = i * 2.4
		local y = ((i % 4) - 1.5) * 1.1
		local r = 2 * math.sqrt(math.max(0.05, 1 - (y / 2.6) ^ 2))
		ball(Vector3.new(0.8, 0.8, 0.8), Vector3.new(math.cos(a) * r * 0.97, y, math.sin(a) * r * 0.97 - 0.2), theme.c1)
	end
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 0.3, -11), Vector3.zero)
	cam.Parent = vp
	vp.CurrentCamera = cam
	return vp, m
end

local function playHatch(eggId, results, fast)
	local ov = mk("TextButton", {Parent = UI.root, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Text = "", ZIndex = 60, AutoButtonColor = false})
	local skip = false
	ov.MouseButton1Click:Connect(function() skip = true end)
	local n = #results
	local cols = n == 1 and 1 or (n == 3 and 3 or 4)
	local size = n == 1 and 280 or (n == 3 and 210 or 150)
	local rows = math.ceil(n / cols)
	local wait = function(t) if fast or skip then t = t * 0.35 end task.wait(t) end
	local done = 0
	local hasTitanic = false
	for _, r in ipairs(results) do if Config.Pets[r].titanic then hasTitanic = true end end
	for i, name in ipairs(results) do
		local cx = (i - 1) % cols
		local cy = math.floor((i - 1) / cols)
		local cell = mk("Frame", {Parent = ov, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size + 34), Position = UDim2.new(0.5, (cx - (cols - 1) / 2) * (size + 10), 0.5, (cy - (rows - 1) / 2) * (size + 44)), BackgroundTransparency = 1, ZIndex = 61})
		local box = mk("Frame", {Parent = cell, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, ZIndex = 61})
		local evp = eggViewport(box, eggId)
		evp.ZIndex = 62
		local pet = Config.Pets[name]
		task.spawn(function()
			-- wobble
			local cam = evp.CurrentCamera
			local t0 = os.clock()
			local dur = fast and 0.7 or 1.5
			local cracked = false
			while os.clock() - t0 < dur and not skip do
				local a = (os.clock() - t0) / dur
				local w = math.sin((os.clock() - t0) * (10 + a * 18)) * (0.08 + a * 0.35)
				cam.CFrame = CFrame.lookAt(Vector3.new(0, 0.3, -11), Vector3.zero) * CFrame.Angles(0, 0, w)
				if not cracked and a > 0.5 then cracked = true S.sfx("Crack", 0.5, 1) end
				if a > 0.8 and math.random() < 0.15 then S.sfx("Crack", 0.3, 1.2 + a) end
				task.wait()
			end
			if pet.titanic then
				UI.flash(Color3.fromRGB(255, 60, 40), 2)
				S.shakeAmp = math.max(S.shakeAmp, 1.5)
				S.sfx("Titanic", 1, 0.7)
				wait(0.6)
			end
			-- burst
			evp:Destroy()
			local fl = mk("Frame", {Parent = box, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 70})
			round(fl, 20)
			TS:Create(fl, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
			S.sfx("Hatch", 0.7, 1)
			local vp, rig, pcam = S.petIcon(box, name)
			vp.ZIndex = 63
			local origin = pcam.CFrame
			local far = pet.titanic and 5 or 3
			local t1 = os.clock()
			while os.clock() - t1 < 0.55 do
				local a = (os.clock() - t1) / 0.55
				local e = 1 - (1 - a) ^ 3
				local over = 1 + math.sin(a * math.pi) * 0.12
				pcam.CFrame = origin * CFrame.new(0, 0, (1 - e) * far * (origin.Position.Magnitude) * 0.3) * CFrame.new(0, 0, -origin.Position.Magnitude * (over - 1))
				task.wait()
			end
			pcam.CFrame = origin
			local rc = S.rarityColor(name)
			local isNew = not snapshot[name]
			local nameL = label(cell, (isNew and "NEW! " or "") .. pet.display, n == 1 and 30 or 17, rc, {Position = UDim2.fromOffset(0, size), Size = UDim2.new(1, 0, 0, 34), ZIndex = 65, TextStrokeTransparency = 0})
			nameL.TextScaled = n > 1
			stroke(box, rc, 4)
			round(box, 20)
			local order = Config.Rarities[pet.rarity].order
			if order >= 4 then
				S.sfx("Rare", 0.4 + order * 0.05, 1)
				for k = 1, 8 do
					local st = label(box, order >= 6 and "✨" or "⭐", 22, nil, {Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 68})
					local ang = k / 8 * math.pi * 2
					TS:Create(st, TweenInfo.new(0.9), {Position = UDim2.fromScale(0.5 + math.cos(ang) * 0.6, 0.5 + math.sin(ang) * 0.6), TextTransparency = 1}):Play()
				end
				if order >= 6 then UI.flash(rc, 0.7) end
			end
			if pet.titanic then
				local big = label(ov, "★ TITANIC ★", 60, Color3.fromRGB(255, 220, 80), {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.14), Size = UDim2.fromOffset(500, 70), ZIndex = 80, TextStrokeTransparency = 0})
				TS:Create(big, TweenInfo.new(0.6, Enum.EasingStyle.Back), {Size = UDim2.fromOffset(560, 80)}):Play()
				S.sfx("Rare", 1, 0.7)
			end
			done = done + 1
		end)
	end
	local t = os.clock()
	while done < n and os.clock() - t < 12 do task.wait(0.1) end
	local hold = hasTitanic and 3.2 or (fast and 0.5 or 1.4)
	local h0 = os.clock()
	while os.clock() - h0 < hold and not skip do task.wait(0.05) end
	ov:Destroy()
end

---------------------------------------------------------------- buttons
local function doHatch(count)
	if busy or not nearEgg then return false end
	busy = true
	lastCount = count
	local eggId = nearEgg
	local res = S.invoke("Hatch", eggId, count)
	if not res or not res.ok then
		UI.toast(res and res.err or "Hatch failed", "error")
		busy = false
		return false
	end
	S.sfx("Buy", 0.6)
	playHatch(eggId, res.results, auto)
	busy = false
	return true
end

local bx = 296
for i, c in ipairs({1, 3, 8}) do
	hBtns[c] = button(panel, "Hatch x" .. c, c == 1 and pal.good or (c == 3 and pal.blue or Color3.fromRGB(150, 90, 230)), UDim2.fromOffset(190, 44), UDim2.fromOffset(bx, 40 + (i - 1) * 50), function() doHatch(c) end, {TextSize = 17, ZIndex = 9})
end
local autoBtn
autoBtn = button(panel, "Auto Hatch: OFF", pal.bad, UDim2.fromOffset(190, 22), UDim2.fromOffset(bx, 190), function(b)
	auto = not auto
	b.Text = "Auto Hatch: " .. (auto and "ON" or "OFF")
	b.BackgroundColor3 = auto and pal.good or pal.bad
end, {TextSize = 14, ZIndex = 9})
panel.Size = UDim2.fromOffset(500, 222)

task.spawn(function()
	while true do
		task.wait(0.3)
		if not nearEgg and auto then auto = false autoBtn.Text = "Auto Hatch: OFF" autoBtn.BackgroundColor3 = pal.bad end
		if auto and nearEgg and not busy then
			if not doHatch(lastCount) then
				auto = false
				autoBtn.Text = "Auto Hatch: OFF"
				autoBtn.BackgroundColor3 = pal.bad
			end
		end
	end
end)

return H
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Starter</string><ProtectedString name="Source"><![CDATA[-- Starter (ModuleScript) | StarterPlayerScripts.Client.Starter
-- First-join creature selection: a client-side 3D stage with an animated intro for each starter.
local S = require(script.Parent.Shared)
local UI = require(script.Parent.UI)
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TS = S.TS
local MB, pal, mk, round, stroke, label, button = S.MB, S.pal, S.mk, S.round, S.stroke, S.label, S.button
local Starter = {}
local camera = workspace.CurrentCamera
local running = false

local function ease(a) return 1 - (1 - a) ^ 3 end

function Starter.run()
	if running then return end
	running = true
	local Y = 5000
	local stage = Instance.new("Folder")
	stage.Name = "StarterStage"
	stage.Parent = workspace
	local saved = {Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness, FogEnd = Lighting.FogEnd}
	Lighting.Ambient = Color3.fromRGB(120, 100, 160)
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 100, 160)
	Lighting.ClockTime = 21
	Lighting.FogEnd = 100000

	local function part(size, cf, color, mat, shape)
		local p = Instance.new("Part")
		p.Anchored = true p.CanCollide = false p.CanQuery = false
		p.Size = size p.CFrame = cf p.Color = color p.Material = mat or Enum.Material.SmoothPlastic
		if shape == "Cyl" then p.Shape = Enum.PartType.Cylinder end
		p.Parent = stage
		return p
	end
	local function pedestal(x, color)
		part(Vector3.new(2, 24, 24), CFrame.new(x, Y - 1, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(70, 70, 90), Enum.Material.Marble, "Cyl")
		part(Vector3.new(0.5, 26, 26), CFrame.new(x, Y + 0.1, 0) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, "Cyl")
		local l = Instance.new("PointLight") l.Color = color l.Range = 40 l.Brightness = 3 l.Parent = part(Vector3.new(1, 1, 1), CFrame.new(x, Y + 12, -4), color, Enum.Material.Neon)
	end
	pedestal(-17, Color3.fromRGB(90, 220, 90))
	pedestal(17, Color3.fromRGB(255, 90, 60))
	part(Vector3.new(160, 22, 22), CFrame.new(0, Y - 3, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(35, 30, 55), Enum.Material.Slate, "Cyl").Size = Vector3.new(2, 160, 160)
	local back = part(Vector3.new(220, 110, 1), CFrame.new(0, Y + 40, 55), Color3.fromRGB(40, 20, 80))
	local sg = Instance.new("SurfaceGui") sg.Face = Enum.NormalId.Front sg.Parent = back
	local f = mk("Frame", {Parent = sg, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1)})
	mk("UIGradient", {Parent = f, Rotation = 90, Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 10, 50)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(150, 50, 120)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 160, 80))})})

	local K = 3.6
	local dino = MB.Pet("StarterDino")
	local drag = MB.Pet("StarterDragon")
	for _, r in ipairs({dino, drag}) do
		r.model.PrimaryPart.Anchored = true
		r.model.Parent = stage
		r.model:ScaleTo(K)
		r.d = (r.model:GetAttribute("Drop") or 2)
	end
	local dinoDrop = dino.model:GetAttribute("Drop") * K / (dino.model:GetAttribute("Scale") and 1 or 1)
	dino.drop = dinoDrop / 1
	drag.drop = drag.model:GetAttribute("Drop") * K

	camera.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local last = t0
	local roarAt, fireAt = nil, nil
	local fire = Instance.new("ParticleEmitter")
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 60, 20))
	fire.Lifetime = NumberRange.new(0.5, 0.9) fire.Speed = NumberRange.new(26, 36) fire.Rate = 0 fire.LightEmission = 1
	fire.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 4)})
	fire.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
	fire.SpreadAngle = Vector2.new(8, 8) fire.EmissionDirection = Enum.NormalId.Front
	fire.Parent = drag.model.Head
	local chosen
	local stepCount = 0

	RunService:BindToRenderStep("StarterStage", Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		local dt = math.min(now - last, 0.1)
		last = now
		local t = now - t0
		-- DINO: stomps in from the left
		local a = math.clamp(t / 3.2, 0, 1)
		local dx = -90 + 73 * ease(a)
		local dspeed = a < 1 and 30 or 0
		dino.model.PrimaryPart.CFrame = CFrame.new(dx, Y + dino.drop, 0) * CFrame.Angles(0, math.rad(180 - 180 + 18 * (1 - ease(a))), 0)
		MB.Animate(dino, dt, dspeed, false, 0)
		if dspeed > 0 then
			local st = math.floor(dino.phase / math.pi)
			if st ~= stepCount then
				stepCount = st
				S.sfx("Stomp", 0.4, 0.9)
				S.shakeAmp = math.max(S.shakeAmp, 0.35)
				S.burst(Vector3.new(dx, Y + 0.5, 0), Color3.fromRGB(200, 180, 150), 10, 2, 10, 0.8)
			end
		elseif not roarAt then
			roarAt = now
			S.sfx("Hatch", 0.8, 0.5)
			S.shakeAmp = 0.8
		end
		if roarAt then
			local r = math.clamp((now - roarAt) / 1.2, 0, 1)
			local pulse = math.sin(r * math.pi)
			dino.joints.Jaw.Transform = CFrame.Angles(-0.8 * pulse, 0, 0)
			dino.joints.Neck.Transform = CFrame.Angles(0.5 * pulse, 0, 0)
		end
		-- DRAGON: swoops in from the sky and breathes fire
		local b = math.clamp((t - 0.4) / 3.4, 0, 1)
		local e = ease(b)
		local pos = Vector3.new(17 + 60 * (1 - e), Y + drag.drop + 9 + 50 * (1 - e) + math.sin(now * 2) * 0.8 * e, 60 * (1 - e))
		local face = Vector3.new(17 - pos.X, -(pos.Y - (Y + drag.drop + 9)) * 0.7, -pos.Z).Magnitude > 0.5 and CFrame.lookAt(pos, Vector3.new(17, Y + drag.drop + 9 + 2, -40)) or CFrame.new(pos)
		drag.model.PrimaryPart.CFrame = (b < 1) and face or (CFrame.new(pos) * CFrame.Angles(0, 0, 0))
		MB.Animate(drag, dt, 0, true, 0)
		if b >= 1 and not fireAt then
			fireAt = now
			S.sfx("Titanic", 0.5, 1.2)
			S.shakeAmp = 0.5
		end
		if fireAt then
			local r = now - fireAt
			fire.Rate = (r < 1.4) and 220 or 0
			drag.joints.Jaw.Transform = CFrame.Angles((r < 1.4) and -0.7 or 0, 0, 0)
		end
		camera.CFrame = CFrame.lookAt(Vector3.new(0, Y + 14, -46), Vector3.new(0, Y + 11, 0))
		camera.FieldOfView = 55
	end)

	-- UI
	local overlay = mk("Frame", {Parent = UI.root, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 40})
	local title = label(overlay, "CHOOSE YOUR COMPANION", 42, Color3.fromRGB(255, 230, 100), {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(700, 52), ZIndex = 41, TextStrokeTransparency = 0})
	label(overlay, "Both creatures have exactly the same power. This choice is permanent.", 18, Color3.new(1, 1, 1), {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 62), Size = UDim2.fromOffset(700, 26), ZIndex = 41, TextStrokeTransparency = 0.3})
	local sel
	local confirm
	local function pick(kind)
		sel = kind
		confirm.Visible = true
		confirm.Text = "Confirm " .. (kind == "Dino" and "🦖 Dinosaur" or "🐉 Dragon")
		confirm.BackgroundColor3 = kind == "Dino" and Color3.fromRGB(60, 190, 80) or Color3.fromRGB(230, 80, 50)
	end
	local b1 = button(overlay, "🦖 Dinosaur\n⚔ 5 damage", Color3.fromRGB(50, 150, 70), UDim2.fromOffset(230, 70), UDim2.new(0.5, -300, 1, -170), function() pick("Dino") end, {ZIndex = 41, TextSize = 24})
	local b2 = button(overlay, "🐉 Dragon\n⚔ 5 damage", Color3.fromRGB(200, 70, 45), UDim2.fromOffset(230, 70), UDim2.new(0.5, 70, 1, -170), function() pick("Dragon") end, {ZIndex = 41, TextSize = 24})
	confirm = button(overlay, "Confirm", pal.good, UDim2.fromOffset(280, 54), UDim2.new(0.5, -140, 1, -90), function(btn)
		if not sel or chosen then return end
		chosen = true
		local ok = S.invoke("ChooseStarter", sel)
		if not ok then chosen = false return end
		btn.Visible = false b1.Visible = false b2.Visible = false
		title.Text = sel == "Dino" and "A mighty Dinosaur joins you!" or "A fierce Dragon joins you!"
		UI.flash(Color3.new(1, 1, 1), 1.2)
		S.sfx("Rare", 0.8)
		task.wait(2)
		RunService:UnbindFromRenderStep("StarterStage")
		overlay:Destroy()
		stage:Destroy()
		Lighting.Ambient = saved.Ambient Lighting.OutdoorAmbient = saved.OutdoorAmbient
		Lighting.ClockTime = saved.ClockTime Lighting.Brightness = saved.Brightness Lighting.FogEnd = saved.FogEnd
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70
		running = false
	end, {ZIndex = 41, TextSize = 22, Visible = false})
end

return Starter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Ride</string><ProtectedString name="Source"><![CDATA[-- Ride (ModuleScript) | StarterPlayerScripts.Client.Ride
-- Titanic mounting: dragons fly (smooth physics flight), dinosaurs stomp (character lifted onto the back).
local S = require(script.Parent.Shared)
local UI = require(script.Parent.UI)
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Config, MB = S.Config, S.MB
local Ride = {}
local camera = workspace.CurrentCamera
local player = S.player

local active
local upHeld, downHeld = false, false

UI.rideUp.MouseButton1Down:Connect(function() upHeld = true end)
UI.rideUp.MouseButton1Up:Connect(function() upHeld = false end)
UI.rideUp.MouseLeave:Connect(function() upHeld = false end)
UI.rideDown.MouseButton1Down:Connect(function() downHeld = true end)
UI.rideDown.MouseButton1Up:Connect(function() downHeld = false end)
UI.rideDown.MouseLeave:Connect(function() downHeld = false end)

local function getControls()
	local ok, c = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 3)):GetControls()
	end)
	return ok and c or nil
end
local controls

local function stop()
	if not active then return end
	local a = active
	active = nil
	RunService:UnbindFromRenderStep("BBRide")
	if a.lv then a.lv:Destroy() end
	if a.ao then a.ao:Destroy() end
	if a.att then a.att:Destroy() end
	local hum = a.hum
	if hum and hum.Parent then
		hum.PlatformStand = false
		hum.HipHeight = a.hip
		hum.WalkSpeed = 22
		hum.JumpHeight = 7.2
		hum.JumpPower = 50
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 128
	UI.showRide(false)
	upHeld, downHeld = false, false
end

local function start(name)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local pet = Config.Pets[name]
	if not hum or not hrp or not pet then return end
	stop()
	-- measure the model once
	local probe = MB.Pet(name)
	local saddle = probe.model:GetAttribute("Saddle") or 4
	local scale = probe.scale
	probe.model:Destroy()
	local a = {hum = hum, hip = hum.HipHeight, kind = pet.kind, scale = scale}
	active = a
	S.sfx("Mount", 0.8, 0.8)
	UI.flash(Color3.fromRGB(255, 230, 150), 0.6)
	S.shakeAmp = math.max(S.shakeAmp, 0.5)
	player.CameraMaxZoomDistance = 500
	player.CameraMinZoomDistance = math.min(30 + scale * 4, 90)
	UI.showRide(true, pet.kind == "Dragon")
	if pet.kind == "Dino" then
		local r15 = hum.RigType == Enum.HumanoidRigType.R15
		hum.HipHeight = saddle + (r15 and 2 or 0)
		hum.WalkSpeed = 26
		hum.JumpHeight = 0
		hum.JumpPower = 0
		hrp.CFrame = hrp.CFrame + Vector3.new(0, saddle, 0)
		RunService:BindToRenderStep("BBRide", Enum.RenderPriority.Camera.Value - 1, function() end)
	else
		controls = controls or getControls()
		hum.PlatformStand = true
		hrp.CFrame = hrp.CFrame + Vector3.new(0, 6 + scale, 0)
		local att = Instance.new("Attachment") att.Parent = hrp
		local lv = Instance.new("LinearVelocity")
		lv.Attachment0 = att
		lv.MaxForce = math.huge
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.VectorVelocity = Vector3.zero
		lv.Parent = hrp
		local ao = Instance.new("AlignOrientation")
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = math.huge
		ao.Responsiveness = 14
		ao.RigidityEnabled = false
		ao.Parent = hrp
		a.att, a.lv, a.ao = att, lv, ao
		local vel = Vector3.zero
		local yaw = math.atan2(-hrp.CFrame.LookVector.X, -hrp.CFrame.LookVector.Z)
		RunService:BindToRenderStep("BBRide", Enum.RenderPriority.Camera.Value - 1, function(dt)
			if not active or not hrp.Parent then return end
			local mv = controls and controls:GetMoveVector() or Vector3.zero
			local cf = camera.CFrame
			local dir = cf.LookVector * (-mv.Z) + cf.RightVector * mv.X
			local up = (UIS:IsKeyDown(Enum.KeyCode.Space) or upHeld) and 1 or ((UIS:IsKeyDown(Enum.KeyCode.LeftShift) or downHeld) and -1 or 0)
			dir = dir + Vector3.new(0, up * 0.8, 0)
			local speed = 70 + scale * 1.5
			local target = Vector3.zero
			if dir.Magnitude > 0.05 then target = dir.Unit * speed * math.min(dir.Magnitude, 1) end
			vel = vel:Lerp(target, 1 - math.exp(-dt * 2.6))
			lv.VectorVelocity = vel
			if vel.Magnitude > 8 then
				ao.CFrame = CFrame.lookAt(Vector3.zero, vel.Unit)
				yaw = math.atan2(-vel.X, -vel.Z)
			else
				ao.CFrame = CFrame.Angles(0, yaw, 0)
			end
		end)
	end
end

player:GetAttributeChangedSignal("Riding"):Connect(function()
	local n = player:GetAttribute("Riding")
	if n then start(n) else stop() end
end)
player.CharacterRemoving:Connect(stop)

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.F and player:GetAttribute("Riding") then
		S.invoke("Ride", "")
	end
end)

return Ride
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>