	StarterDragon = {k = "dragon", s = 0.62, c1 = RGB(205, 65, 50), c2 = RGB(255, 190, 120), c3 = RGB(120, 30, 30), head = 1.2, horns = 1, wing = 1.5},
	Velociraptor = {k = "biped", s = 0.55, c1 = RGB(176, 120, 60), c2 = RGB(240, 215, 170), c3 = RGB(90, 50, 30), neck = 0.9, head = 0.85, legs = 1.25, claws = true, tailLen = 1.3, spikes = 0},
