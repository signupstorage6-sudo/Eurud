	-- TITANICS: unique, heavily detailed designs (not scaled copies)
	TitanicVoidWyrm = {k = "dragon", s = 11, c1 = RGB(12, 8, 22), c2 = RGB(70, 0, 130), c3 = RGB(40, 0, 80), eye = RGB(255, 60, 255), veins = true, glow = RGB(200, 70, 255), fx = RGB(170, 60, 255), horns = 5, hornLen = 1.5, wing = 2.8, wings2 = true, bulk = 1.3, head = 1.25, crown = true, orbs = 6, spikeMat = Enum.Material.Neon, wingMat = Enum.Material.ForceField, titanic = true},
