local coinBox = mk("Frame", {Parent = root, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(240, 44), BackgroundColor3 = pal.bg})
round(coinBox, 22) stroke(coinBox, Color3.fromRGB(255, 200, 60), 3)
local coinIcon = label(coinBox, "🪙", 28, nil, {Size = UDim2.fromOffset(44, 44)})
