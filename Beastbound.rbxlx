for id, e in pairs(C.Eggs) do e.id = id end

C.EggOrder = {"AncientPlains", "JurassicJungle", "FrozenTundra", "DragonMountains", "VolcanicWasteland", "CrystalCaverns", "ShadowRealm", "CelestialKingdom", "DragonSanctuary", "PrimalDimension"}

