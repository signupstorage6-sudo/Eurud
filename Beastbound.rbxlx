local areaName = label(areaBox, "Spawn", 22, pal.acc, {Size = UDim2.new(1, -10, 0.55, 0), Position = UDim2.fromOffset(8, 2), TextXAlignment = Enum.TextXAlignment.Left})
local areaSub = label(areaBox, "", 14, pal.dim, {Size = UDim2.new(1, -10, 0.4, 0), Position = UDim2.new(0, 8, 0.58, 0), TextXAlignment = Enum.TextXAlignment.Left})
function UI.setArea(i)
	if i == 0 then
		areaName.Text = "Main Spawn" areaSub.Text = "Hatch eggs here!"
		return
	end
	local a = Config.Areas[i]
	areaName.Text = a.name
	areaName.TextColor3 = a.theme.glow
	areaSub.Text = "Enemy HP " .. S.fmt(a.hp) .. "+  |  Coins " .. S.fmt(a.reward) .. "+"
end
UI.setArea(0)

-- panels
local panels = {}
local current
local function closeAll()
	for n, p in pairs(panels) do p.frame.Visible = false end
	current = nil
end
function UI.panel(name, w, h, title)
	local f = mk("Frame", {Name = name, Parent = root, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(w, h), BackgroundColor3 = pal.panel, Visible = false, ZIndex = 10})
	round(f, 18) stroke(f, Color3.fromRGB(15, 15, 30), 4)
	local sc = mk("UIScale", {Parent = f})
	local bar = mk("Frame", {Parent = f, Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = pal.panel2, ZIndex = 11})
	round(bar, 18)
	mk("Frame", {Parent = bar, Position = UDim2.new(0, 0, 1, -16), Size = UDim2.new(1, 0, 0, 16), BackgroundColor3 = pal.panel2, BorderSizePixel = 0, ZIndex = 11})
	label(bar, title, 26, pal.acc, {Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(14, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12})
	button(bar, "X", pal.bad, UDim2.fromOffset(38, 34), UDim2.new(1, -44, 0, 5), function() closeAll() end, {ZIndex = 13})
	local p = {frame = f, scale = sc}
	panels[name] = p
	return f, p
end
function UI.open(name)
	if current == name then closeAll() return end
	closeAll()
	local p = panels[name]
	if not p then return end
	current = name
	p.frame.Visible = true
	p.scale.Scale = 0.8
	TS:Create(p.scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Scale = 1}):Play()
	if p.onOpen then p.onOpen() end
end
function UI.close() closeAll() end
function UI.isOpen(name) return current == name end
function UI.onOpen(name, fn) panels[name].onOpen = fn end

-- side buttons
local side = mk("Frame", {Parent = root, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(74, 330), BackgroundTransparency = 1})
mk("UIListLayout", {Parent = side, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center})
