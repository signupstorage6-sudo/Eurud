<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><Item class="Workspace" referent="RBX10"><Properties><string name="Name">Workspace</string></Properties><Item class="Terrain" referent="RBX9"><Properties><string name="Name">Terrain</string></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX13"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config (ModuleScript) | ReplicatedStorage.Config
local C = {}

C.Rarities = {
	Common = {order = 1, color = Color3.fromRGB(200, 200, 200)},
	Uncommon = {order = 2, color = Color3.fromRGB(90, 225, 90)},
	Rare = {order = 3, color = Color3.fromRGB(70, 140, 255)},
	Epic = {order = 4, color = Color3.fromRGB(175, 85, 255)},
	Legendary = {order = 5, color = Color3.fromRGB(255, 190, 40)},
	Mythical = {order = 6, color = Color3.fromRGB(255, 70, 120)},
	Divine = {order = 7, color = Color3.fromRGB(255, 250, 170)},
	Exclusive = {order = 8, color = Color3.fromRGB(0, 255, 230)},
	Titanic = {order = 9, color = Color3.fromRGB(255, 60, 60)}, -- label only, NOT a tier
}

-- dmg = final damage per hit (1 hit / second / pet)
C.Pets = {
	StarterDino = {kind = "Dino", rarity = "Common", dmg = 5, display = "Starter Dino"},
	StarterDragon = {kind = "Dragon", rarity = "Common", dmg = 5, display = "Starter Dragon"},

