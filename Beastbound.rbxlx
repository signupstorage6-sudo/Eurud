C.TierMult = {1, 2.5, 6, 25}
C.TierRespawn = {12, 15, 22, 45}

C.World = {Ring = 760, AreaRadius = 230, SpawnRadius = 115, GateRadius = 520}
function C.AreaCenter(i)
	local a = math.rad((i - 1) * 36 - 90)
	return Vector3.new(math.cos(a) * C.World.Ring, 0, math.sin(a) * C.World.Ring)
end

C.MaxEquipped = 4
C.HitInterval = 1.0
C.AttackRange = 170

-- built-in Roblox sounds (swap any for your own rbxassetid:// ids)
C.Sounds = {
	Buy = "rbxasset://sounds/electronicpingshort.wav",
	Crack = "rbxasset://sounds/impact_water.mp3",
	Hatch = "rbxasset://sounds/impact_explosion_03.mp3",
	Rare = "rbxasset://sounds/victory.wav",
	Hit = "rbxasset://sounds/swordslash.wav",
	Defeat = "rbxasset://sounds/splat.wav",
	Coin = "rbxasset://sounds/snap.mp3",
	Unlock = "rbxasset://sounds/victory.wav",
	Titanic = "rbxasset://sounds/impact_explosion_03.mp3",
	Mount = "rbxasset://sounds/bass.wav",
	Flap = "rbxasset://sounds/swordslash.wav",
	Stomp = "rbxasset://sounds/impact_explosion_03.mp3",
	Click = "rbxasset://sounds/clickfast.wav",
}
C.MusicId = "" -- optional: put rbxassetid://... here; Settings > Music slider controls it

function C.GetDamage(name) return C.Pets[name].dmg end

function C.Format(n)
	n = math.floor(n + 0.5)
	if n < 10000 then
		local s = tostring(n)
		return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
	end
	local suf = {"", "K", "M", "B", "T", "Qa"}
	local i = 1
	local v = n
	while v >= 1000 and i < #suf do v = v / 1000 i = i + 1 end
	return string.format(v >= 100 and "%.0f%s" or (v >= 10 and "%.1f%s" or "%.2f%s"), v, suf[i])
end

function C.OddsText(pct)
	if pct >= 1 then return string.format("%.4g%%", pct) end
	local inv = 100 / pct
	return string.format("1 in %s", C.Format(inv))
end

return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">ModelBuilder</string><ProtectedString name="Source"><![CDATA[-- ModelBuilder (ModuleScript) | ReplicatedStorage.ModelBuilder
-- Builds every creature from rounded parts joined with Motor6D so they can be animated procedurally.
-- Pet models face -Z. Root is the body centre. Attribute "Drop" = studs from Root to the ground.
local M = {}
local SM = Enum.Material.SmoothPlastic
local V, CF, A = Vector3.new, CFrame.new, CFrame.Angles
local function T(x, y, z, rx, ry, rz) return CF(x, y, z) * A(rx or 0, ry or 0, rz or 0) end
local function mix(a, b, t) return a:Lerp(b, t) end
local WHITE, BLACK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)

---------------------------------------------------------------- builder core
local B = {}
B.__index = B

local function newPart(model, name, size, color, mat, kind)
	local p = Instance.new(kind == "Wedge" and "WedgePart" or "Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat or SM
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if kind == "Ball" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif kind == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = model
	return p
end

local function newBuilder(name, scale)
	local self = setmetatable({}, B)
	self.model = Instance.new("Model")
	self.model.Name = name
	self.S = scale
	self.parts = {}
	self.joints = {}
	self.trans = 0
	return self
end

function B:root(size, color, mat)
	local p = newPart(self.model, "Root", size * self.S, color, mat, "Ball")
	p.CFrame = CF()
	self.parts.Root = p
	self.model.PrimaryPart = p
	return p
end

-- name, parent name, kind (Ball/Block/Cyl/Wedge), size, c0 (design units), pivot (child-local point on the joint), colour, material
function B:add(name, parent, kind, size, c0, pivot, color, mat, transp)
	local S = self.S
	local p = newPart(self.model, name, size * S, color, mat, kind)
	local t = transp or self.trans
	if t > 0 then p.Transparency = t end
	local c0s = CF(c0.Position * S) * (c0 - c0.Position)
	local pv = (pivot or Vector3.zero) * S
	local par = self.parts[parent]
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = par
	m.Part1 = p
	m.C0 = c0s
	m.C1 = CF(pv)
	m.Parent = par
	p.CFrame = par.CFrame * c0s * CF(pv):Inverse()
	self.parts[name] = p
	self.joints[name] = m
	return p
end

---------------------------------------------------------------- shared decorations
local function eyes(b, parent, hs, color, x, y, z)
	for _, s in ipairs({-1, 1}) do
		b:add(s < 0 and "EyeL" or "EyeR", parent, "Ball", V(0.15, 0.15, 0.15) * hs, T(s * x * hs, y * hs, z * hs), nil, color, Enum.Material.Neon, 0)
	end
end

local function horns(b, parent, hs, n, color, len, x, y, z, sweep)
	for i = 1, n do
		for _, s in ipairs({-1, 1}) do
			local nm = (s < 0 and "HornL" or "HornR") .. i
			b:add(nm, parent, "Ball", V(0.11, len, 0.11) * hs, T(s * (x + (i - 1) * 0.1) * hs, (y + (i - 1) * 0.05) * hs, (z + (i - 1) * 0.28) * hs, sweep or 0.7, 0, s * 0.25), V(0, -len / 2, 0), color)
		end
	end
end

local function tail(b, parent, n, len, w, color, startC0, tipColor)
	local prev = parent
	local c0 = startC0
	for i = 1, n do
		local f = 1 - (i - 1) / (n + 0.6)
		local l = len * (0.85 + 0.15 * f)
		b:add("Tail" .. i, prev, "Ball", V(w * f, w * f * 0.9, l), c0, V(0, 0, -l / 2), (i == n and tipColor) or color)
		prev = "Tail" .. i
		c0 = T(0, 0, l / 2, 0, 0, 0)
	end
	return prev
end

local function leg(b, side, parentName, nameSuffix, px, py, pz, th, sh, w, color, footColor, toes)
	local sn = side < 0 and "L" or "R"
	b:add("Thigh" .. nameSuffix .. sn, parentName, "Ball", V(w, th, w * 1.2), T(side * px, py, pz), V(0, th * 0.45, 0), color)
	b:add("Shin" .. nameSuffix .. sn, "Thigh" .. nameSuffix .. sn, "Ball", V(w * 0.55, sh, w * 0.6), T(0, -th * 0.42, -0.05, -0.35), V(0, sh * 0.45, 0), color)
	b:add("Foot" .. nameSuffix .. sn, "Shin" .. nameSuffix .. sn, "Ball", V(w * 0.8, 0.18, w * 1.5), T(0, -sh * 0.45, -w * 0.4, 0.35), nil, footColor)
	if toes then
		b:add("Claw" .. nameSuffix .. sn, "Foot" .. nameSuffix .. sn, "Ball", V(w * 0.5, 0.1, 0.3), T(0, 0, -w * 0.85), nil, WHITE)
	end
	return th * 0.87 + sh * 0.85 + 0.09
end

local function aura(model, color, rate, size, speed)
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(1, 2)
	pe.Speed = NumberRange.new(speed or 2, (speed or 2) * 2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.LightEmission = 0.8
	pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0)})
	pe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
	pe.Parent = model.PrimaryPart
	return pe
end

---------------------------------------------------------------- DINOSAURS
local function biped(b, L)
	local c1 = L.c1
	local c2 = L.c2 or mix(c1, WHITE, 0.5)
	local c3 = L.c3 or mix(c1, BLACK, 0.45)
	local bw = L.bulk or 1
	local lg = L.legs or 1
	b.trans = L.ghost or 0
	b:root(V(1.3 * bw, 1.4 * bw, 2.3), c1, L.mat)
	b:add("Belly", "Root", "Ball", V(1.0 * bw, 0.9 * bw, 2.0), T(0, -0.28, -0.05), nil, c2)
	b:add("Chest", "Root", "Ball", V(1.2 * bw, 1.3 * bw, 1.5), T(0, 0.12, -1.0), nil, c1, L.mat)
	local nl = L.neck or 1
	b:add("Neck", "Chest", "Ball", V(0.62 * bw, 0.62 * bw, nl), T(0, 0.35, -0.5, 0.5), V(0, 0, nl / 2), c1, L.mat)
	local hs = L.head or 1
	b:add("Head", "Neck", "Ball", V(0.78 * hs, 0.72 * hs, 1.0 * hs), T(0, 0, -nl / 2 + 0.05, -0.5), V(0, 0, 0.45 * hs), c1, L.mat)
	b:add("Snout", "Head", "Ball", V(0.52 * hs, 0.42 * hs, (L.snout or 0.8) * hs), T(0, -0.06 * hs, -0.6 * hs), nil, c1, L.mat)
	b:add("Jaw", "Head", "Ball", V(0.55 * hs, 0.22 * hs, 1.0 * hs), T(0, -0.28 * hs, 0.2 * hs), V(0, 0, 0.5 * hs), c2)
	b:add("Teeth", "Jaw", "Ball", V(0.44 * hs, 0.09 * hs, 0.8 * hs), T(0, 0.1 * hs, -0.1 * hs), nil, WHITE)
	eyes(b, "Head", hs, L.eye or Color3.fromRGB(255, 200, 40), 0.36, 0.14, -0.2)
	if L.horns then horns(b, "Head", hs, L.horns, c3, 0.5, 0.2, 0.33, 0.0, 0.5) end
	if L.crest then
		b:add("Crest", "Head", "Ball", V(0.08, 0.55 * hs, 0.9 * hs), T(0, 0.45 * hs, -0.1 * hs), nil, c3)
	end
	if L.frill then
		for _, s in ipairs({-1, 1}) do
			b:add(s < 0 and "FrillL" or "FrillR", "Neck", "Ball", V(0.9, 0.9, 0.08), T(s * 0.32, 0.1, -nl * 0.3, 0, s * 0.9), nil, c3)
		end
	end
	local th, sh = 1.0 * lg, 0.9 * lg
	local drop
	for _, s in ipairs({-1, 1}) do
		drop = leg(b, s, "Root", "", 0.55 * bw, -0.4, 0.25, th, sh, 0.55 * bw, c1, c3, true)
	end
	drop = drop + 0.4
	if not L.noarms then
		local al = L.armlen or 0.55
		for _, s in ipairs({-1, 1}) do
			local n = s < 0 and "L" or "R"
			b:add("Arm" .. n, "Chest", "Ball", V(0.16, al, 0.18), T(s * 0.55 * bw, -0.2, -0.5, -0.5), V(0, al * 0.4, 0), c1)
			b:add("Hand" .. n, "Arm" .. n, "Ball", V(0.12, 0.12, L.claws and 1.1 or 0.3), T(0, -al * 0.45, -0.1), nil, L.claws and WHITE or c3)
		end
	end
	local tl = L.tailLen or 1.0
	local last = tail(b, "Root", L.tailseg or 4, 0.95 * tl, 0.85 * bw, c1, T(0, 0.08, 1.0), L.club and c3 or nil)
	if L.club then b:add("Club", last, "Ball", V(0.9, 0.65, 0.9), T(0, 0, 0.6), nil, c3) end
	if L.spikes then
		for i = 1, L.spikes do
			b:add("Spike" .. i, "Root", "Ball", V(0.1, 0.38, 0.28), T(0, 0.72 * bw, -1.4 + i * (2.6 / L.spikes), -0.2), V(0, -0.15, 0), c3, L.spikeMat)
		end
	end
	if L.sail then
		b:add("Sail", "Root", "Ball", V(0.1, 1.9, 2.3), T(0, 1.0, -0.2), nil, c3)
		b:add("Sail2", "Sail", "Ball", V(0.1, 0.9, 1.2), T(0, 0.8, 0.1), nil, mix(c3, WHITE, 0.3))
	end
	if L.cracks then
		for i = 1, 5 do
			b:add("Crack" .. i, "Root", "Ball", V(0.04, 0.12, 0.5), T((i % 2 == 0 and 1 or -1) * 0.5 * bw, 0.35 - i * 0.05, -1.2 + i * 0.5, 0.2, 0, 0.4), nil, L.glow or Color3.fromRGB(255, 120, 20), Enum.Material.Neon, 0)
		end
	end
	if L.angel then
		for _, s in ipairs({-1, 1}) do
			local n = s < 0 and "L" or "R"
			b:add("Wing" .. n .. "1", "Chest", "Ball", V(1.8, 0.1, 0.9), T(s * 0.55, 0.55, 0.3, 0, 0, s * 0.6), V(-s * 0.9, 0, 0), WHITE)
			b:add("Wing" .. n .. "2", "Wing" .. n .. "1", "Ball", V(1.4, 0.08, 0.7), T(s * 0.5, 0, 0.45, 0, -s * 0.3, 0), V(-s * 0.7, 0, 0), mix(WHITE, c3, 0.3))
		end
	end
	if L.halo then
		local h = b:add("Halo", "Head", "Cyl", V(0.06, 1.0, 1.0), T(0, 0.85 * hs, 0.1, 0, 0, math.pi / 2), nil, L.glow or Color3.fromRGB(255, 230, 120), Enum.Material.Neon, 0)
	end
	b:add("Saddle", "Root", "Block", V(0.1, 0.1, 0.1), T(0, 0.75 * bw, 0.1), nil, c1, nil, 1)
	b.model:SetAttribute("Drop", drop * b.S)
	b.model:SetAttribute("Saddle", (drop + 0.75 * bw) * b.S)
end

local function quad(b, L)
	local c1 = L.c1
	local c2 = L.c2 or mix(c1, WHITE, 0.5)
	local c3 = L.c3 or mix(c1, BLACK, 0.45)
	local bw = L.bulk or 1
	b.trans = L.ghost or 0
	b:root(V(1.9 * bw, 1.6 * bw, 3.2), c1, L.mat)
	b:add("Belly", "Root", "Ball", V(1.5 * bw, 1.0 * bw, 2.8), T(0, -0.3, 0), nil, c2)
	local nl = L.neck or 0.9
	local up = L.neckup or 0.35
	b:add("Neck", "Root", "Ball", V(0.8 * bw, 0.8 * bw, nl), T(0, 0.2, -1.4, up), V(0, 0, nl / 2), c1, L.mat)
	local hs = L.head or 1
	b:add("Head", "Neck", "Ball", V(0.85 * hs, 0.7 * hs, 1.1 * hs), T(0, 0, -nl / 2 + 0.05, -up), V(0, 0, 0.45 * hs), c1, L.mat)
	b:add("Snout", "Head", "Ball", V(0.6 * hs, 0.45 * hs, 0.7 * hs), T(0, -0.1 * hs, -0.55 * hs), nil, c2)
	b:add("Jaw", "Head", "Ball", V(0.5 * hs, 0.18 * hs, 0.8 * hs), T(0, -0.3 * hs, 0.15 * hs), V(0, 0, 0.4 * hs), c2)
	eyes(b, "Head", hs, L.eye or Color3.fromRGB(255, 230, 90), 0.4, 0.14, -0.15)
	if L.beak then b:add("Beak", "Head", "Ball", V(0.4 * hs, 0.35 * hs, 0.5 * hs), T(0, -0.12 * hs, -0.75 * hs), nil, c3) end
	if L.trihorns then
		b:add("HornC", "Head", "Ball", V(0.12, 0.12, 0.8 * hs), T(0, 0.0, -0.8 * hs, 0.2), nil, c3)
		for _, s in ipairs({-1, 1}) do
			b:add(s < 0 and "HornL" or "HornR", "Head", "Ball", V(0.14, 0.14, 1.2 * hs), T(s * 0.28 * hs, 0.32 * hs, -0.25 * hs, 0.35, s * 0.12, 0), V(0, 0, 0.6 * hs), c3)
		end
	end
	if L.frill then
		b:add("Frill", "Head", "Ball", V(1.7 * hs, 1.5 * hs, 0.12), T(0, 0.35 * hs, 0.5 * hs, -0.35), nil, c2)
		b:add("FrillRim", "Frill", "Ball", V(1.8 * hs, 1.6 * hs, 0.08), T(0, 0, 0.06), nil, c3)
	end
	local lh = L.legh or 1
	local drop = 0
	for _, fz in ipairs({-1, 1}) do
		for _, s in ipairs({-1, 1}) do
			local nm = (fz < 0 and "F" or "B") .. (s < 0 and "L" or "R")
			b:add("Leg" .. nm, "Root", "Ball", V(0.62 * bw, 1.1 * lh, 0.62 * bw), T(s * 0.85 * bw, -0.5, fz * 0.95), V(0, 0.5 * lh, 0), c1, L.mat)
			b:add("Paw" .. nm, "Leg" .. nm, "Ball", V(0.7 * bw, 0.2, 0.9 * bw), T(0, -0.52 * lh, -0.1), nil, c3)
			drop = 0.5 + 1.02 * lh + 0.1
		end
	end
	local last = tail(b, "Root", 4, 1.0 * (L.tailLen or 1), 0.95 * bw, c1, T(0, 0.1, 1.45), nil)
	if L.club then
		b:add("Club", last, "Ball", V(1.1, 0.8, 1.1), T(0, 0, 0.6), nil, c3)
	end
	if L.tailSpikes then
		for _, s in ipairs({-1, 1}) do
			b:add(s < 0 and "TSpikeL" or "TSpikeR", last, "Ball", V(0.1, 0.1, 0.9), T(s * 0.2, 0.05, 0.55, 0, -s * 0.6, 0), nil, WHITE)
		end
	end
	if L.plates then
		for i = 1, L.plates do
			local f = 1 - math.abs(i - (L.plates + 1) / 2) / L.plates
			b:add("Plate" .. i, "Root", "Ball", V(0.1, 0.8 * f + 0.3, 0.8 * f + 0.3), T(((i % 2 == 0) and 0.15 or -0.15), 0.85 * bw, -1.2 + i * (2.9 / (L.plates + 1)), 0, 0, 0), V(0, -0.2, 0), c3, L.plateMat)
		end
	end
	if L.armor then
		for i = 1, 6 do
			b:add("Bump" .. i, "Root", "Ball", V(0.5, 0.3, 0.5), T(((i % 2 == 0) and 0.55 or -0.55) * bw, 0.7 * bw, -1.0 + i * 0.4), nil, c3)
		end
	end
	if L.crystals then
		for i = 1, 5 do
			b:add("Cry" .. i, "Root", "Ball", V(0.28, 1.0 - i * 0.1, 0.28), T(((i % 2 == 0) and 0.4 or -0.4), 0.8, -1.1 + i * 0.5, 0, 0, (i % 2 == 0) and -0.3 or 0.3), V(0, -0.35, 0), L.glow or c3, Enum.Material.Neon, 0)
		end
	end
	b:add("Saddle", "Root", "Block", V(0.1, 0.1, 0.1), T(0, 0.8 * bw, 0), nil, c1, nil, 1)
	b.model:SetAttribute("Drop", drop * b.S)
	b.model:SetAttribute("Saddle", (drop + 0.8 * bw) * b.S)
end

---------------------------------------------------------------- DRAGONS
local function wing(b, side, prefix, parent, pos, len, c1, c2, wingMat, big)
	local n = (side < 0 and "L" or "R")
	local nm1, nm2 = prefix .. n .. "1", prefix .. n .. "2"
	b:add(nm1, parent, "Ball", V(len, 0.2, 0.22), T(side * pos.X, pos.Y, pos.Z, 0, 0, side * 0.25), V(-side * len / 2, 0, 0), c1)
	-- inner membrane
	b:add(prefix .. n .. "M1", nm1, "Ball", V(len * 0.95, 0.04, 1.3), T(side * len * 0.45, 0, 0.7), nil, c2, wingMat, 0.05)
	b:add(nm2, nm1, "Ball", V(len * 1.15, 0.16, 0.18), T(side * len / 2, 0, 0, 0, -side * 0.4, 0), V(-side * len * 0.575, 0, 0), c1)
	b:add(prefix .. n .. "M2", nm2, "Ball", V(len * 1.05, 0.04, 1.9), T(side * len * 0.5, 0, 0.9), nil, c2, wingMat, 0.05)
	local fl = {1.5, 1.3, 1.1}
	local an = {0.65, 1.0, 1.35}
	for i = 1, 3 do
		local fn = prefix .. n .. "F" .. i
		b:add(fn, nm1, "Ball", V(len * fl[i] * 0.95, 0.08, 0.08), T(side * len / 2, 0, 0, 0, -side * an[i], 0), V(-side * len * fl[i] * 0.475, 0, 0), c1)
		if i < 3 then
			local mid = (an[i] + an[i + 1]) / 2
			local l2 = len * fl[i + 1] * 0.75
			b:add(fn .. "m", nm1, "Ball", V(l2, 0.035, l2 * 0.62), T(side * len / 2, 0, 0, 0, -side * mid, 0) * T(side * l2 * 0.5, 0, 0), nil, c2, wingMat, 0.05)
		end
	end
end

local function dragon(b, L)
	local c1 = L.c1
	local c2 = L.c2 or mix(c1, WHITE, 0.5)
	local c3 = L.c3 or mix(c1, BLACK, 0.5)
	local bw = L.bulk or 1
	local eye = L.eye or Color3.fromRGB(255, 220, 60)
	b.trans = L.ghost or 0
	b:root(V(1.5 * bw, 1.4 * bw, 2.8), c1, L.mat)
	b:add("Belly", "Root", "Ball", V(1.2 * bw, 0.9 * bw, 2.6), T(0, -0.3, 0), nil, c2)
	b:add("Chest", "Root", "Ball", V(1.45 * bw, 1.4 * bw, 1.6), T(0, 0.1, -1.3), nil, c1, L.mat)
	b:add("Neck", "Chest", "Ball", V(0.62, 0.62, 0.95), T(0, 0.3, -0.55, 0.55), V(0, 0, 0.45), c1, L.mat)
	b:add("Neck2", "Neck", "Ball", V(0.55, 0.55, 0.95), T(0, 0, -0.45, -0.3), V(0, 0, 0.45), c1, L.mat)
	b:add("Neck3", "Neck2", "Ball", V(0.5, 0.5, 0.95), T(0, 0, -0.45, -0.35), V(0, 0, 0.45), c1, L.mat)
	local hs = L.head or 1
	b:add("Head", "Neck3", "Ball", V(0.8 * hs, 0.7 * hs, 1.1 * hs), T(0, 0, -0.45, -0.1), V(0, 0, 0.5 * hs), c1, L.mat)
	b:add("Snout", "Head", "Ball", V(0.52 * hs, 0.4 * hs, 0.85 * hs), T(0, -0.08 * hs, -0.65 * hs), nil, c1, L.mat)
	b:add("Jaw", "Head", "Ball", V(0.5 * hs, 0.2 * hs, 1.0 * hs), T(0, -0.3 * hs, 0.2 * hs), V(0, 0, 0.5 * hs), c2)
	b:add("Teeth", "Jaw", "Ball", V(0.4 * hs, 0.09 * hs, 0.8 * hs), T(0, 0.1 * hs, -0.1 * hs), nil, WHITE)
	b:add("Nostril", "Snout", "Ball", V(0.18, 0.1, 0.12), T(0, 0.14 * hs, -0.35 * hs), nil, L.glow or eye, Enum.Material.Neon, 0)
	eyes(b, "Head", hs, eye, 0.36, 0.15, -0.25)
	horns(b, "Head", hs, L.horns or 1, c3, L.hornLen or 0.9, 0.22, 0.3, 0.15, 1.0)
	if L.crown then
		for i = 1, 5 do
			b:add("Crown" .. i, "Head", "Ball", V(0.1, 0.45, 0.1), T((i - 3) * 0.16 * hs, 0.5 * hs, -0.1 * hs, 0, 0, (i - 3) * 0.12), V(0, -0.2, 0), Color3.fromRGB(255, 215, 70), Enum.Material.Neon, 0)
		end
	end
	-- spine ridge
	for i = 1, 6 do
		b:add("Ridge" .. i, "Root", "Ball", V(0.1, 0.4, 0.3), T(0, 0.7 * bw, -1.8 + i * 0.55, -0.3), V(0, -0.15, 0), c3, L.spikeMat)
	end
	-- legs: hind
	local drop
	for _, s in ipairs({-1, 1}) do
		drop = leg(b, s, "Root", "", 0.6 * bw, -0.35, 0.8, 0.9, 0.8, 0.55 * bw, c1, c3, true)
		local n = s < 0 and "L" or "R"
		b:add("FLeg" .. n, "Chest", "Ball", V(0.3, 0.8, 0.32), T(s * 0.55 * bw, -0.45, -0.4, -0.2), V(0, 0.3, 0), c1)
		b:add("FPaw" .. n, "FLeg" .. n, "Ball", V(0.36, 0.14, 0.55), T(0, -0.38, -0.12), nil, c3)
	end
	drop = drop + 0.35
	-- wings
	local wl = L.wing or 1.7
	for _, s in ipairs({-1, 1}) do
		wing(b, s, "Wing", "Chest", V(0.55, 0.6, 0.1), wl, c1, L.wingColor or c2, L.wingMat, false)
	end
	if L.wings2 then
		for _, s in ipairs({-1, 1}) do
			wing(b, s, "WingB", "Root", V(0.5, 0.35, 0.9), wl * 0.7, c1, L.wingColor or c2, L.wingMat, false)
		end
	end
	local last = tail(b, "Root", 6, 0.95, 0.9 * bw, c1, T(0, 0.05, 1.3), nil)
	b:add("Spade", last, "Ball", V(0.9, 0.08, 0.75), T(0, 0, 0.5), nil, c3)
	if L.halo then
		b:add("Halo", "Head", "Cyl", V(0.07, 1.4, 1.4), T(0, 0.95 * hs, 0.1, 0, 0, math.pi / 2), nil, L.glow or Color3.fromRGB(255, 230, 120), Enum.Material.Neon, 0)
	end
	if L.veins then
		for i = 1, 5 do
			b:add("Vein" .. i, "Root", "Ball", V(0.05, 0.1, 0.7), T(((i % 2 == 0) and 0.55 or -0.55) * bw, 0.3, -1.4 + i * 0.55, 0.1, 0, (i % 2 == 0) and -0.4 or 0.4), nil, L.glow or c2, Enum.Material.Neon, 0)
		end
	end
	if L.orbs then
		for i = 1, L.orbs do
			local a = (i / L.orbs) * math.pi * 2
			b:add("Orb" .. i, "Root", "Ball", V(0.35, 0.35, 0.35), T(math.cos(a) * 2.4, 1.4, math.sin(a) * 1.8), nil, L.glow or c2, Enum.Material.Neon, 0)
		end
	end
	b:add("Saddle", "Root", "Block", V(0.1, 0.1, 0.1), T(0, 0.75 * bw, -0.1), nil, c1, nil, 1)
	b.model:SetAttribute("Drop", drop * b.S)
	b.model:SetAttribute("Saddle", 0.75 * bw * b.S)
end

---------------------------------------------------------------- LOOKS
