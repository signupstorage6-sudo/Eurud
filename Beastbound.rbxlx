-- equipped bar
local eqBar = mk("Frame", {Parent = root, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(280, 66), BackgroundColor3 = pal.bg, BackgroundTransparency = 0.2})
round(eqBar, 14) stroke(eqBar, Color3.new(0, 0, 0), 3)
mk("UIListLayout", {Parent = eqBar, FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6)})
local function refreshEq()
	for _, c in ipairs(eqBar:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	local d = S.data
	if not d then return end
	for i = 1, Config.MaxEquipped do
		local name = d.equipped[i]
		local slot = mk("Frame", {Parent = eqBar, Size = UDim2.fromOffset(58, 58), BackgroundColor3 = pal.panel, LayoutOrder = i})
		round(slot, 10)
		stroke(slot, name and S.rarityColor(name) or Color3.fromRGB(20, 20, 30), 3)
		if name then
			S.petIcon(slot, name)
			local b = mk("TextButton", {Parent = slot, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = ""})
			b.MouseButton1Click:Connect(function() S.invoke("Unequip", i) end)
		else
			label(slot, "+", 26, pal.dim, {Size = UDim2.fromScale(1, 1)})
		end
	end
end

---------------------------------------------------------------- inventory
local inv, invp = UI.panel("Inventory", 700, 420, "🎒 My Creatures")
local searchBox = mk("TextBox", {Parent = inv, Position = UDim2.fromOffset(12, 52), Size = UDim2.fromOffset(190, 32), BackgroundColor3 = pal.bg, PlaceholderText = "🔍 Search...", Text = "", TextColor3 = Color3.new(1, 1, 1), PlaceholderColor3 = pal.dim, Font = Enum.Font.GothamBold, TextSize = 16, ClearTextOnFocus = false, ZIndex = 11})
round(searchBox, 10)
local sortMode = 1
local sortNames = {"Sort: Damage", "Sort: Rarity", "Sort: Name", "Sort: Count"}
local rebuildInv
local sortBtn = button(inv, sortNames[1], pal.blue, UDim2.fromOffset(120, 32), UDim2.fromOffset(210, 52), function(b)
	sortMode = sortMode % 4 + 1
	b.Text = sortNames[sortMode]
	rebuildInv()
end, {TextSize = 15, ZIndex = 11})
local eqCount = label(inv, "Equipped 0/4", 18, pal.acc, {Position = UDim2.fromOffset(340, 52), Size = UDim2.fromOffset(130, 32), ZIndex = 11})
button(inv, "Equip Best", pal.good, UDim2.fromOffset(100, 32), UDim2.fromOffset(470, 52), function() S.invoke("EquipBest") end, {TextSize = 15, ZIndex = 11})
button(inv, "Unequip All", pal.bad, UDim2.fromOffset(100, 32), UDim2.fromOffset(576, 52), function() S.invoke("UnequipAll") end, {TextSize = 15, ZIndex = 11})
local grid = mk("ScrollingFrame", {Parent = inv, Position = UDim2.fromOffset(12, 92), Size = UDim2.fromOffset(470, 318), BackgroundColor3 = pal.bg, BackgroundTransparency = 0.3, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 11, BorderSizePixel = 0})
round(grid, 12)
mk("UIGridLayout", {Parent = grid, CellSize = UDim2.fromOffset(104, 128), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder})
mk("UIPadding", {Parent = grid, PaddingLeft = UDim.new(0, 8), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8)})
local detail = mk("Frame", {Parent = inv, Position = UDim2.fromOffset(492, 92), Size = UDim2.fromOffset(196, 318), BackgroundColor3 = pal.bg, BackgroundTransparency = 0.3, ZIndex = 11})
round(detail, 12)
local selected

local function eqCountOf(name)
	local n = 0
	for _, v in ipairs(S.data.equipped) do if v == name then n = n + 1 end end
	return n
end

local function showDetail()
	for _, c in ipairs(detail:GetChildren()) do c:Destroy() end
	if not selected or not S.data.owned[selected] then
		label(detail, "Select a creature", 18, pal.dim, {Size = UDim2.fromScale(1, 1), ZIndex = 12})
		return
	end
	local pet = Config.Pets[selected]
	local iconBox = mk("Frame", {Parent = detail, Position = UDim2.fromOffset(18, 8), Size = UDim2.fromOffset(160, 120), BackgroundColor3 = pal.panel, ZIndex = 12})
	round(iconBox, 12) stroke(iconBox, S.rarityColor(selected), 3)
	local vp = S.petIcon(iconBox, selected)
	vp.ZIndex = 13
	label(detail, pet.display, 20, S.rarityColor(selected), {Position = UDim2.fromOffset(4, 132), Size = UDim2.new(1, -8, 0, 40), ZIndex = 12})
	label(detail, pet.rarity .. (pet.titanic and "  (egg exclusive)" or ""), 14, S.rarityColor(selected), {Position = UDim2.fromOffset(4, 172), Size = UDim2.new(1, -8, 0, 18), ZIndex = 12})
	label(detail, "⚔ Damage: " .. S.fmt(pet.dmg) .. "   |   Owned: " .. S.data.owned[selected], 14, Color3.new(1, 1, 1), {Position = UDim2.fromOffset(4, 192), Size = UDim2.new(1, -8, 0, 34), ZIndex = 12})
	button(detail, "Equip", pal.good, UDim2.fromOffset(86, 32), UDim2.fromOffset(8, 232), function() S.invoke("Equip", selected) end, {TextSize = 16, ZIndex = 12})
	button(detail, "Unequip", pal.bad, UDim2.fromOffset(86, 32), UDim2.fromOffset(102, 232), function()
		for i, v in ipairs(S.data.equipped) do if v == selected then S.invoke("Unequip", i) break end end
	end, {TextSize = 15, ZIndex = 12})
	if pet.titanic then
		local riding = S.player:GetAttribute("Riding") == selected
		button(detail, riding and "⬇ Dismount" or (pet.kind == "Dragon" and "🐉 Ride & Fly!" or "🦖 Ride!"), pal.acc, UDim2.fromOffset(180, 34), UDim2.fromOffset(8, 274), function()
			S.invoke("Ride", riding and "" or selected)
			UI.close()
		end, {TextSize = 17, ZIndex = 12, TextColor3 = Color3.new(0, 0, 0)})
	end
end

local rarOrder = Config.Rarities
rebuildInv = function()
	if not S.data then return end
	for _, c in ipairs(grid:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	local list = {}
	local q = searchBox.Text:lower()
	for name, n in pairs(S.data.owned) do
		local pet = Config.Pets[name]
		if q == "" or pet.display:lower():find(q, 1, true) or pet.rarity:lower():find(q, 1, true) then list[#list + 1] = name end
	end
	table.sort(list, function(a, b)
		local pa, pb = Config.Pets[a], Config.Pets[b]
		if sortMode == 1 then if pa.dmg ~= pb.dmg then return pa.dmg > pb.dmg end
		elseif sortMode == 2 then local ra, rb = rarOrder[pa.rarity].order, rarOrder[pb.rarity].order if ra ~= rb then return ra > rb end
		elseif sortMode == 4 then if S.data.owned[a] ~= S.data.owned[b] then return S.data.owned[a] > S.data.owned[b] end end
		if sortMode == 3 then return pa.display < pb.display end
		return pa.display < pb.display
	end)
	for i, name in ipairs(list) do
		local pet = Config.Pets[name]
		local cell = mk("TextButton", {Parent = grid, BackgroundColor3 = pal.panel, Text = "", LayoutOrder = i, ZIndex = 12})
		round(cell, 12)
		stroke(cell, S.rarityColor(name), 3)
		local ib = mk("Frame", {Parent = cell, Size = UDim2.new(1, -8, 0, 76), Position = UDim2.fromOffset(4, 4), BackgroundTransparency = 1, ZIndex = 12})
		local vp = S.petIcon(ib, name) vp.ZIndex = 13
		label(cell, pet.display, 13, Color3.new(1, 1, 1), {Position = UDim2.fromOffset(2, 82), Size = UDim2.new(1, -4, 0, 28), ZIndex = 13})
		label(cell, "⚔ " .. S.fmt(pet.dmg), 13, pal.acc, {Position = UDim2.fromOffset(2, 110), Size = UDim2.new(1, -4, 0, 16), ZIndex = 13})
		if S.data.owned[name] > 1 then label(cell, "x" .. S.data.owned[name], 14, Color3.new(1, 1, 1), {Position = UDim2.new(1, -34, 0, 4), Size = UDim2.fromOffset(30, 16), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 14, TextStrokeTransparency = 0}) end
		local n = eqCountOf(name)
		if n > 0 then label(cell, "✔" .. (n > 1 and n or ""), 16, pal.good, {Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(30, 18), ZIndex = 14, TextStrokeTransparency = 0}) end
		cell.MouseButton1Click:Connect(function()
			S.sfx("Click", 0.4)
			selected = name
			showDetail()
		end)
	end
	eqCount.Text = "Equipped " .. #S.data.equipped .. "/" .. Config.MaxEquipped
	showDetail()
end
searchBox:GetPropertyChangedSignal("Text"):Connect(function() rebuildInv() end)
UI.onOpen("Inventory", rebuildInv)

---------------------------------------------------------------- index
local idx = UI.panel("Index", 700, 420, "📖 Creature Index")
local idxCount = label(idx, "", 18, pal.acc, {Position = UDim2.fromOffset(280, 8), Size = UDim2.fromOffset(300, 30), ZIndex = 12})
local idxGrid = mk("ScrollingFrame", {Parent = idx, Position = UDim2.fromOffset(12, 52), Size = UDim2.fromOffset(676, 358), BackgroundColor3 = pal.bg, BackgroundTransparency = 0.3, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 11, BorderSizePixel = 0})
round(idxGrid, 12)
mk("UIGridLayout", {Parent = idxGrid, CellSize = UDim2.fromOffset(124, 152), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder})
mk("UIPadding", {Parent = idxGrid, PaddingLeft = UDim.new(0, 8), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8)})
local idxOrder = {"StarterDino", "StarterDragon"}
for _, id in ipairs(Config.EggOrder) do
	for _, o in ipairs(Config.Eggs[id].odds) do idxOrder[#idxOrder + 1] = o[1] end
end
local function rebuildIndex()
	if not S.data then return end
	for _, c in ipairs(idxGrid:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	local found = 0
	for i, name in ipairs(idxOrder) do
		local pet = Config.Pets[name]
		local got = S.data.discovered[name] == true
		if got then found = found + 1 end
		local cell = mk("Frame", {Parent = idxGrid, BackgroundColor3 = pal.panel, LayoutOrder = i, ZIndex = 12})
		round(cell, 12)
		stroke(cell, got and S.rarityColor(name) or Color3.fromRGB(20, 20, 30), 3)
		local ib = mk("Frame", {Parent = cell, Size = UDim2.new(1, -8, 0, 76), Position = UDim2.fromOffset(4, 4), BackgroundTransparency = 1, ZIndex = 12})
		local vp = S.petIcon(ib, name, nil, not got) vp.ZIndex = 13
		label(cell, got and pet.display or "???", 13, Color3.new(1, 1, 1), {Position = UDim2.fromOffset(2, 80), Size = UDim2.new(1, -4, 0, 28), ZIndex = 13})
		label(cell, got and (pet.rarity .. "  ⚔ " .. S.fmt(pet.dmg)) or "Undiscovered", 12, got and S.rarityColor(name) or pal.dim, {Position = UDim2.fromOffset(2, 108), Size = UDim2.new(1, -4, 0, 16), ZIndex = 13})
		label(cell, pet.egg and Config.Eggs[pet.egg].display or "Starter", 11, pal.dim, {Position = UDim2.fromOffset(2, 126), Size = UDim2.new(1, -4, 0, 16), ZIndex = 13})
	end
	idxCount.Text = "Discovered " .. found .. " / " .. #idxOrder
end
UI.onOpen("Index", rebuildIndex)

