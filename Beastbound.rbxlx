	FireDrake = {k = "dragon", s = 0.6, c1 = RGB(210, 70, 40), c2 = RGB(250, 170, 60), c3 = RGB(110, 30, 20), fx = RGB(255, 140, 40), horns = 1},
	Dilophosaurus = {k = "biped", s = 0.62, c1 = RGB(80, 170, 150), c2 = RGB(220, 240, 200), c3 = RGB(230, 90, 70), frill = true, crest = true, neck = 1.1, head = 0.9, legs = 1.1},
	Carnotaurus = {k = "biped", s = 0.7, c1 = RGB(170, 60, 50), c2 = RGB(230, 170, 120), c3 = RGB(60, 30, 30), horns = 1, bulk = 1.1, head = 1.2, armlen = 0.3},
	Brachiosaurus = {k = "quad", s = 0.7, c1 = RGB(110, 150, 190), c2 = RGB(190, 215, 235), neck = 3.4, neckup = 1.05, head = 0.6, legh = 1.4, bulk = 1.1, tailLen = 1.2},
	ToxicDragon = {k = "dragon", s = 0.62, c1 = RGB(80, 190, 70), c2 = RGB(190, 235, 60), c3 = RGB(40, 90, 40), fx = RGB(150, 255, 60), veins = true, glow = RGB(170, 255, 60), horns = 2},
	TRex = {k = "biped", s = 0.78, c1 = RGB(110, 95, 70), c2 = RGB(190, 170, 130), c3 = RGB(50, 40, 30), bulk = 1.3, head = 1.5, neck = 0.8, armlen = 0.3, spikes = 0},
	IceDragon = {k = "dragon", s = 0.66, c1 = RGB(150, 220, 255), c2 = RGB(235, 250, 255), c3 = RGB(90, 150, 210), fx = RGB(210, 240, 255), horns = 2, wingMat = Enum.Material.Glass},
	Therizinosaurus = {k = "biped", s = 0.75, c1 = RGB(130, 90, 60), c2 = RGB(235, 220, 190), c3 = RGB(60, 45, 35), neck = 1.7, head = 0.7, claws = true, armlen = 1.1, bulk = 1.25, legs = 1.05},
	Spinosaurus = {k = "biped", s = 0.78, c1 = RGB(70, 110, 130), c2 = RGB(180, 210, 190), c3 = RGB(215, 110, 50), sail = true, snout = 1.4, head = 1.2, neck = 1.2, bulk = 1.15},
	StormDragon = {k = "dragon", s = 0.7, c1 = RGB(80, 90, 150), c2 = RGB(200, 210, 255), c3 = RGB(40, 40, 90), fx = RGB(180, 210, 255), veins = true, glow = RGB(255, 245, 120), horns = 2, wings2 = false},
	Giganotosaurus = {k = "biped", s = 0.88, c1 = RGB(150, 100, 80), c2 = RGB(215, 185, 150), c3 = RGB(60, 40, 35), bulk = 1.35, head = 1.45, armlen = 0.3, spikes = 3},
	ThunderDragon = {k = "dragon", s = 0.78, c1 = RGB(235, 195, 60), c2 = RGB(70, 55, 35), c3 = RGB(70, 55, 35), fx = RGB(255, 245, 120), veins = true, glow = RGB(255, 255, 140), horns = 2},
	RoyalDragon = {k = "dragon", s = 0.85, c1 = RGB(120, 40, 160), c2 = RGB(255, 210, 80), c3 = RGB(255, 210, 80), crown = true, horns = 2, fx = RGB(255, 220, 120), wing = 1.9},
	IndominusRex = {k = "biped", s = 0.95, c1 = RGB(235, 235, 225), c2 = RGB(255, 255, 250), c3 = RGB(185, 185, 175), bulk = 1.4, head = 1.5, spikes = 6, claws = true, armlen = 0.7, eye = RGB(255, 40, 40)},
	InfernoDragon = {k = "dragon", s = 0.9, c1 = RGB(50, 25, 20), c2 = RGB(255, 110, 20), c3 = RGB(255, 110, 20), veins = true, glow = RGB(255, 120, 30), fx = RGB(255, 110, 20), horns = 2, wing = 2.0, spikeMat = Enum.Material.Neon},
	MagmaRex = {k = "biped", s = 1.0, c1 = RGB(50, 30, 28), c2 = RGB(90, 50, 40), c3 = RGB(255, 110, 20), cracks = true, glow = RGB(255, 120, 20), fx = RGB(255, 120, 20), bulk = 1.4, head = 1.5, spikes = 5, spikeMat = Enum.Material.Neon, eye = RGB(255, 140, 30)},
	AncientDragon = {k = "dragon", s = 1.0, c1 = RGB(130, 120, 90), c2 = RGB(215, 195, 135), c3 = RGB(70, 60, 45), horns = 3, hornLen = 1.2, wing = 2.1, bulk = 1.15, veins = true, glow = RGB(120, 255, 170)},
	CrystalDragon = {k = "dragon", s = 1.0, c1 = RGB(120, 200, 255), c2 = RGB(200, 240, 255), c3 = RGB(60, 150, 255), mat = Enum.Material.Glass, wingMat = Enum.Material.Glass, spikeMat = Enum.Material.Neon, horns = 2, fx = RGB(180, 240, 255), wing = 2.0},
	GeodeSaurus = {k = "quad", s = 1.0, c1 = RGB(110, 80, 150), c2 = RGB(170, 140, 210), c3 = RGB(200, 150, 255), crystals = true, glow = RGB(210, 150, 255), bulk = 1.2, head = 1.0, fx = RGB(210, 150, 255)},
	PrismWyrm = {k = "dragon", s = 1.05, c1 = RGB(225, 150, 255), c2 = RGB(150, 255, 235), c3 = RGB(255, 230, 130), wingMat = Enum.Material.Neon, veins = true, glow = RGB(255, 255, 255), horns = 3, wing = 2.2, fx = RGB(255, 190, 255)},
	ShadowDragon = {k = "dragon", s = 1.05, c1 = RGB(35, 25, 50), c2 = RGB(110, 55, 170), c3 = RGB(20, 12, 30), eye = RGB(255, 40, 220), fx = RGB(150, 60, 220), horns = 3, wing = 2.1},
	PhantomRaptor = {k = "biped", s = 1.0, c1 = RGB(110, 100, 175), c2 = RGB(190, 180, 255), c3 = RGB(60, 50, 120), ghost = 0.45, eye = RGB(255, 255, 255), neck = 1.1, legs = 1.3, claws = true, fx = RGB(150, 140, 255), tailLen = 1.4},
	VoidDragon = {k = "dragon", s = 1.1, c1 = RGB(15, 8, 25), c2 = RGB(90, 0, 160), c3 = RGB(60, 0, 110), eye = RGB(255, 60, 255), veins = true, glow = RGB(190, 60, 255), fx = RGB(170, 60, 255), horns = 3, wing = 2.4, wings2 = true},
	CelestialDragon = {k = "dragon", s = 1.1, c1 = RGB(255, 245, 215), c2 = RGB(255, 215, 90), c3 = RGB(255, 200, 70), halo = true, glow = RGB(255, 230, 120), fx = RGB(255, 235, 150), horns = 2, wing = 2.3, spikeMat = Enum.Material.Neon},
	AngelSaurus = {k = "biped", s = 1.1, c1 = RGB(250, 245, 235), c2 = RGB(255, 255, 255), c3 = RGB(255, 215, 100), angel = true, halo = true, glow = RGB(255, 235, 130), fx = RGB(255, 235, 150), neck = 1.3, head = 0.95, legs = 1.2, bulk = 1.1},
	SolarWyrm = {k = "dragon", s = 1.15, c1 = RGB(255, 180, 40), c2 = RGB(255, 255, 210), c3 = RGB(255, 120, 20), mat = Enum.Material.Neon, halo = true, glow = RGB(255, 240, 150), fx = RGB(255, 200, 80), horns = 3, wing = 2.4, orbs = 3},
	ElderDragon = {k = "dragon", s = 1.2, c1 = RGB(90, 75, 60), c2 = RGB(165, 140, 100), c3 = RGB(50, 40, 30), horns = 4, hornLen = 1.4, veins = true, glow = RGB(80, 255, 230), wing = 2.5, bulk = 1.25, wings2 = true, fx = RGB(80, 255, 230)},
	SanctuaryRex = {k = "biped", s = 1.2, c1 = RGB(235, 215, 150), c2 = RGB(255, 245, 210), c3 = RGB(255, 195, 60), mat = Enum.Material.Metal, spikes = 7, spikeMat = Enum.Material.Neon, bulk = 1.45, head = 1.5, horns = 2, halo = true, glow = RGB(255, 200, 80), fx = RGB(255, 210, 100)},
	PrimalRaptor = {k = "biped", s = 1.15, c1 = RGB(210, 90, 30), c2 = RGB(255, 205, 90), c3 = RGB(110, 30, 20), neck = 1.1, legs = 1.35, claws = true, tailLen = 1.4, cracks = true, glow = RGB(255, 220, 60), head = 1.1, fx = RGB(255, 160, 60), spikes = 6},
