		part(par, "MonolithRune", V(0.6, 24, 0.6), CF(p + V(0, 24, 0)) * A(0, a, 0.1) * CF(0, 0, -3.6), Color3.fromRGB(190, 70, 255), Mat.Neon, nil, false)
	end
