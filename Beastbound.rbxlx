	CelestialKingdom = {display = "Celestial Egg", price = 150000000, area = 8, odds = {{"CelestialDragon", 55}, {"AngelSaurus", 33}, {"SolarWyrm", 12}}},
	DragonSanctuary = {display = "Sanctuary Egg", price = 1000000000, area = 9, odds = {{"ElderDragon", 70}, {"SanctuaryRex", 29.99999}, {"TitanicCelestialDrake", 0.00001}}},
	PrimalDimension = {display = "Primal Egg", price = 8000000000, area = 10, odds = {{"PrimalRaptor", 70}, {"ChronoDragon", 29.999995}, {"TitanicApexRex", 0.000005}}},
