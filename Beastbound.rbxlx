AreaBuild[4] = function(c, par, ed)
	Terrain:FillCylinder(CF(c + V(0, -10, 0)), 20, 230, Mat.Rock)
	for i = 1, 9 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(110, 200)
		local p = c + V(math.cos(a) * r, 0, math.sin(a) * r)
		local h = rng:NextNumber(40, 75)
		for k = 0, 5 do
			Terrain:FillCylinder(CF(p + V(0, k * h / 6, 0)), h / 6 + 1, 38 - k * 5.5, k < 4 and Mat.Rock or Mat.Snow)
		end
		if i % 3 == 0 then task.wait() end
	end
	hills(c, Mat.Slate, 14, 30, 200, 10, 22, -6)
	scatter(c, 20, 215, 40, function(p) K.rock(par, p, rng:NextNumber(1.2, 3), Color3.fromRGB(110, 110, 125), Mat.Granite) end)
	scatter(c, 20, 215, 22, function(p) K.pine(par, p, rng:NextNumber(0.9, 1.4), Color3.fromRGB(50, 90, 60), false) end, true, ed)
	-- dragon nest with huge eggs
	local nc = c + V(0, 0, 20)
	Terrain:FillCylinder(CF(nc + V(0, -1, 0)), 4, 36, Mat.Ground)
	for i = 1, 14 do local a = i / 14 * 6.283 part(par, "NestTwig", V(18, 1.4, 1.4), CF(nc + V(math.cos(a) * 28, 1, math.sin(a) * 28)) * A(0, -a + 1.57, 0.2), Color3.fromRGB(100, 75, 50), Mat.Wood, "Cyl", false) end
	for i = 1, 4 do local a = i / 4 * 6.283 part(par, "DragonEgg", V(9, 12, 9), CF(nc + V(math.cos(a) * 10, 6, math.sin(a) * 10)), pick({Color3.fromRGB(200, 70, 50), Color3.fromRGB(70, 100, 200), Color3.fromRGB(60, 160, 90)}), Mat.Slate, "Ball") end
	K.skull(par, c + V(-80, 0, -60), 1.7, Color3.fromRGB(215, 205, 190), 0.8)
	emitter(par, c + V(0, 60, 0), V(380, 2, 380), Color3.fromRGB(230, 235, 245), 14, 3, 8, 0.1, 0.9)
end

AreaBuild[5] = function(c, par, ed)
	Terrain:FillCylinder(CF(c + V(0, -10, 0)), 20, 230, Mat.Basalt)
	hills(c, Mat.Basalt, 14, 40, 200, 10, 22, -7)
	hills(c, Mat.Slate, 6, 40, 200, 8, 14, -6)
	-- volcano
	local vc = c + V(0, 0, -40)
	for k = 0, 9 do Terrain:FillCylinder(CF(vc + V(0, k * 8, 0)), 9, 70 - k * 6, Mat.Basalt) end
	Terrain:FillCylinder(CF(vc + V(0, 78, 0)), 5, 16, Mat.CrackedLava)
	emitter(par, vc + V(0, 86, 0), V(14, 2, 14), Color3.fromRGB(255, 120, 30), 80, 40, 2.4, 1, 1.4, Enum.NormalId.Top)
	emitter(par, vc + V(0, 92, 0), V(30, 2, 30), Color3.fromRGB(60, 50, 50), 20, 14, 6, 0, 6, Enum.NormalId.Top)
	for i = 1, 7 do
		local p = c + V(rng:NextNumber(-170, 170), 0, rng:NextNumber(-100, 170))
		if (p - c).Magnitude < 200 and (p - vc).Magnitude > 75 then
			Terrain:FillCylinder(CF(p + V(0, -1.5, 0)), 3, rng:NextNumber(10, 22), Mat.CrackedLava)
			local l = Instance.new("PointLight") l.Color = Color3.fromRGB(255, 110, 30) l.Range = 28 l.Brightness = 2
			local g = part(par, "LavaGlow", V(2, 1, 2), CF(p + V(0, 2, 0)), Color3.fromRGB(255, 100, 20), Mat.Neon, nil, false) g.Transparency = 0.5 l.Parent = g
		end
	end
	scatter(c, 20, 215, 40, function(p) K.deadTree(par, p, rng:NextNumber(0.8, 1.4), Color3.fromRGB(35, 28, 25)) end, true, ed)
	scatter(c, 20, 215, 35, function(p) K.rock(par, p, rng:NextNumber(1, 2.4), Color3.fromRGB(40, 32, 32), Mat.Basalt) end)
	emitter(par, c + V(0, 20, 0), V(380, 20, 380), Color3.fromRGB(255, 130, 40), 40, 6, 5, 1, 0.5, Enum.NormalId.Top)
end

AreaBuild[6] = function(c, par, ed)
	-- hollow cavern dome
	Terrain:FillBall(c, 242, Mat.Slate)
	Terrain:FillBall(c, 226, Mat.Air)
	Terrain:FillCylinder(CF(c + V(0, -10, 0)), 20, 235, Mat.Slate)
	hills(c, Mat.Slate, 12, 40, 190, 10, 20, -7)
	-- entrance tunnel through the dome wall
	Terrain:FillBlock(CF(c + ed * 232 + V(0, 19, 0)) * A(0, math.atan2(-ed.X, -ed.Z), 0), V(36, 38, 40), Mat.Air)
	scatter(c, 15, 215, 50, function(p) K.crystal(par, p, rng:NextNumber(0.8, 1.8), pick({Color3.fromRGB(120, 230, 255), Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 130, 200), Color3.fromRGB(130, 255, 190)}), false) end)
	scatter(c, 15, 215, 15, function(p) K.crystal(par, p, rng:NextNumber(0.8, 1.4), Color3.fromRGB(160, 220, 255), true) end)
	scatter(c, 20, 215, 25, function(p) K.rock(par, p, rng:NextNumber(1, 2.5), Color3.fromRGB(80, 70, 110), Mat.Slate) end)
	-- stalactites
	for i = 1, 30 do
		local a = rng:NextNumber(0, 6.28) local r = rng:NextNumber(0, 200)
		local h = rng:NextNumber(14, 40)
		part(par, "Stalactite", V(7, h, 7), CF(c + V(math.cos(a) * r, 222 - h / 2 - 20, math.sin(a) * r)), Color3.fromRGB(95, 85, 130), Mat.Slate, "Ball", false)
	end
	local lamp = part(par, "CaveGlow", V(4, 4, 4), CF(c + V(0, 150, 0)), Color3.fromRGB(150, 200, 255), Mat.Neon, "Ball", false)
	local l = Instance.new("PointLight") l.Range = 60 l.Brightness = 4 l.Color = Color3.fromRGB(150, 190, 255) l.Parent = lamp
	emitter(par, c + V(0, 70, 0), V(380, 120, 380), Color3.fromRGB(170, 240, 255), 18, 0.8, 7, 1, 0.7, Enum.NormalId.Top)
end

