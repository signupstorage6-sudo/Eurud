	Terrain:FillCylinder(CF(c + V(0, -10, 0)), 20, 230, Mat.Basalt)
	hills(c, Mat.Ground, 14, 40, 200, 10, 24, -7)
	hills(c, Mat.CrackedLava, 6, 60, 190, 6, 10, -5)
	-- primal volcanoes and meteors
	for i = 1, 3 do
