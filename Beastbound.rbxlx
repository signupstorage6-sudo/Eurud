		local m = part(par, "Meteor", V(8, 8, 8) * rng:NextNumber(0.6, 1.6), CF(p), Color3.fromRGB(90, 45, 70), Mat.Basalt, "Ball", false)
		part(par, "MeteorGlow", m.Size * 1.2, CF(p), Color3.fromRGB(255, 120, 200), Mat.Neon, "Ball", false).Transparency = 0.7
	end
	scatter(c, 20, 215, 45, function(p)
		local h = rng:NextNumber(10, 24)
		part(par, "GlowPlant", V(2, h, 2), CF(p + V(0, h / 2, 0)), Color3.fromRGB(255, 120, 200), Mat.Neon, "Ball", false)
		part(par, "GlowLeaf", V(8, 1, 3), CF(p + V(0, h * 0.7, 0)) * A(0, rng:NextNumber(0, 6), 0.4), Color3.fromRGB(120, 255, 190), Mat.Neon, "Ball", false)
	end)
	scatter(c, 20, 215, 30, function(p) K.rock(par, p, rng:NextNumber(1, 2.8), Color3.fromRGB(70, 40, 60), Mat.Basalt) end)
	K.skull(par, c + V(0, 0, -20), 3.2, Color3.fromRGB(205, 190, 170), 0)
	emitter(par, c + V(0, 50, 0), V(380, 80, 380), Color3.fromRGB(255, 150, 200), 40, 1.5, 8, 1, 0.9, Enum.NormalId.Top)
end

---------------------------------------------------------------- spawn + eggs
local function buildEgg(par, cf, area, titanic)
	local theme = area.theme
	local m = Instance.new("Model") m.Name = "EggStand" m.Parent = par
	local big = titanic and 1.35 or 1
	part(m, "Base", V(2, 16, 16) * V(1, big, big), cf * CF(0, 0.6, 0) * A(0, 0, math.pi / 2), Color3.fromRGB(70, 72, 82), Mat.Concrete, "Cyl")
	part(m, "Ring", V(0.5, 14, 14) * V(1, big, big), cf * CF(0, 1.6, 0) * A(0, 0, math.pi / 2), theme.glow, Mat.Neon, "Cyl", false)
	local egg = part(m, "Egg", V(8, 10.5, 8) * big, cf * CF(0, 8 * big, 0), rc(theme.c2, 0.1), Mat.Glass == nil and Mat.SmoothPlastic or Mat.SmoothPlastic, "Ball", false)
	egg.Name = "Egg"
	for i = 1, 8 do
		local a = i / 8 * 6.283 + rng:NextNumber(0, 1)
		local y = rng:NextNumber(-3, 3.5)
		local r = 4 * big * math.sqrt(math.max(0.05, 1 - (y / (5.25 * big)) ^ 2))
		part(m, "Spot", V(1.4, 1.4, 1.4) * big, cf * CF(math.cos(a) * r * 0.97, 8 * big + y * big, math.sin(a) * r * 0.97), theme.c1, Mat.SmoothPlastic, "Ball", false)
	end
	local l = Instance.new("PointLight") l.Color = theme.glow l.Range = 18 l.Brightness = titanic and 3 or 1.2 l.Parent = egg
	if titanic then
		part(m, "Beam", V(1.2, 70, 1.2), cf * CF(0, 40, 0), theme.glow, Mat.Neon, nil, false).Transparency = 0.6
		for i = 1, 4 do
			local a = i / 4 * 6.283
			part(m, "Crown", V(1.2, 5, 1.2) * big, cf * CF(math.cos(a) * 6, 2.5, math.sin(a) * 6), Color3.fromRGB(255, 215, 70), Mat.Neon, "Ball", false)
		end
	end
	local sign = part(m, "Sign", V(1, 1, 1), cf * CF(0, 18 * big + 3, 0), Color3.new(1, 1, 1), Mat.SmoothPlastic, nil, false)
	sign.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Name = "SignGui" gui.Size = UDim2.fromOffset(240, 70) gui.StudsOffset = Vector3.new(0, 1, 0) gui.MaxDistance = 90 gui.Adornee = sign gui.AlwaysOnTop = false
	gui.Parent = sign
	local t1 = Instance.new("TextLabel")
	t1.Name = "Title" t1.BackgroundTransparency = 1 t1.Size = UDim2.new(1, 0, 0.55, 0) t1.Font = Enum.Font.FredokaOne t1.TextScaled = true
	t1.TextColor3 = titanic and Color3.fromRGB(255, 215, 80) or Color3.new(1, 1, 1) t1.TextStrokeTransparency = 0 t1.Text = Config.Eggs[area.egg].display t1.Parent = gui
	local t2 = Instance.new("TextLabel")
	t2.Name = "Price" t2.BackgroundTransparency = 1 t2.Position = UDim2.fromScale(0, 0.55) t2.Size = UDim2.new(1, 0, 0.45, 0) t2.Font = Enum.Font.FredokaOne t2.TextScaled = true
	t2.TextColor3 = Color3.fromRGB(255, 225, 80) t2.TextStrokeTransparency = 0 t2.Text = "🪙 " .. Config.Format(Config.Eggs[area.egg].price) .. (titanic and "  ★ TITANIC" or "") t2.Parent = gui
	m:SetAttribute("EggId", area.egg)
	m.PrimaryPart = egg
	return m
end

local function buildSpawn(par)
	local R = Config.World.SpawnRadius
	Terrain:FillCylinder(CF(0, -10, 0), 20, R + 25, Mat.Grass)
	hills(V(0, 0, 0), Mat.Grass, 14, R - 5, R + 15, 8, 14, -7)
	part(par, "Plaza", V(2, 190, 190), CF(0, 0.15, 0) * A(0, 0, math.pi / 2), Color3.fromRGB(225, 220, 205), Mat.Marble, "Cyl")
	part(par, "PlazaRing", V(2.2, 198, 198), CF(0, 0.05, 0) * A(0, 0, math.pi / 2), Color3.fromRGB(120, 115, 105), Mat.Cobblestone, "Cyl")
	part(par, "PlazaInner", V(2.4, 100, 100), CF(0, 0.3, 0) * A(0, 0, math.pi / 2), Color3.fromRGB(190, 180, 150), Mat.Sandstone, "Cyl")
	-- central landmark: dragon + dino fountain
	part(par, "FountainBase", V(3, 36, 36), CF(0, 1.5, 0) * A(0, 0, math.pi / 2), Color3.fromRGB(170, 165, 155), Mat.Marble, "Cyl")
	Terrain:FillCylinder(CF(0, 1.5, 0), 1, 14, Mat.Water)
	part(par, "FountainWater", V(0.6, 32, 32), CF(0, 3.2, 0) * A(0, 0, math.pi / 2), Color3.fromRGB(80, 170, 255), Mat.Glass, "Cyl", false).Transparency = 0.35
	part(par, "Pedestal", V(4, 4, 4), CF(0, 8, 0), Color3.fromRGB(150, 145, 135), Mat.Marble, "Cyl").CFrame = CF(0, 8, 0) * A(0, 0, math.pi / 2)
	K.skull(par, V(0, 12, 0), 1.0, Color3.fromRGB(235, 228, 205), 0)
	emitter(par, V(0, 14, 0), V(4, 1, 4), Color3.fromRGB(150, 210, 255), 90, 14, 1.8, 0.4, 0.8, Enum.NormalId.Top)
	-- big gateway welcome arch at the plaza edge facing the first road
	K.arch(par, CF(0, 0, 112) * A(0, math.pi, 0), 36, 26, Color3.fromRGB(200, 190, 170), Mat.Cobblestone, Color3.fromRGB(255, 220, 120))
	-- lamps around plaza
	for i = 1, 20 do
		local a = i / 20 * 6.283
		local p = V(math.cos(a) * 88, 0, math.sin(a) * 88)
		part(par, "LampPost", V(0.8, 9, 0.8), CF(p + V(0, 4.5, 0)), Color3.fromRGB(60, 60, 65), Mat.Metal)
		local g = part(par, "Lamp", V(2, 2, 2), CF(p + V(0, 9.5, 0)), Color3.fromRGB(255, 235, 170), Mat.Neon, "Ball", false)
		local l = Instance.new("PointLight") l.Range = 22 l.Brightness = 1.2 l.Color = Color3.fromRGB(255, 225, 150) l.Parent = g
	end
	-- trees around plaza edge
	for i = 1, 26 do
		local a = i / 26 * 6.283 + 0.1
		local r = R + 4
		local p = V(math.cos(a) * r, 0, math.sin(a) * r)
		p = V(p.X, groundY(p.X, p.Z), p.Z)
		K.oak(par, p, rng:NextNumber(1.2, 1.8), Color3.fromRGB(100, 185, 80))
	end
	emitter(par, V(0, 40, 0), V(220, 2, 220), Color3.fromRGB(255, 255, 255), 8, 1, 8, 0.8, 0.4)
	-- egg stands
	local eggs = Instance.new("Folder") eggs.Name = "Eggs" eggs.Parent = par
	local stands = {}
	for i, id in ipairs(Config.EggOrder) do
		local e = Config.Eggs[id]
		local a = (i - 1) / 10 * 6.283 + 0.314
		local p = V(math.cos(a) * 62, 0.3, math.sin(a) * 62)
		local cf = CF(p) * A(0, -a - math.pi / 2, 0)
		local m = buildEgg(eggs, cf, Config.Areas[e.area], id == "ShadowRealm" or id == "DragonSanctuary" or id == "PrimalDimension")
		stands[id] = m
	end
	return stands
end

local function makeRoad(par, from, to, width)
	local d = to - from
	local len = d.Magnitude
	local mid = (from + to) / 2
	local look = CF(mid, mid + d)
	Terrain:FillBlock(CF(mid + V(0, -4, 0)) * (look - look.Position), V(width + 24, 8, len + 6), Mat.Grass)
	local n = math.floor(len / 24)
	for i = 0, n - 1 do
		local c0 = from + d * ((i + 0.5) / n)
		part(par, "Road", V(width, 0.5, len / n + 0.5), CF(c0 + V(0, 0.25, 0), c0 + d + V(0, 0.25, 0)), Color3.fromRGB(150, 140, 125), Mat.Cobblestone)
	end
	for i = 0, n, 2 do
		for _, s in ipairs({-1, 1}) do
			local c0 = from + d * (i / n)
			local side = d.Unit:Cross(V(0, 1, 0)) * s * (width / 2 + 3)
			local g = part(par, "RoadLight", V(1.2, 1.2, 1.2), CF(c0 + side + V(0, 2.5, 0)), Color3.fromRGB(255, 235, 170), Mat.Neon, "Ball", false)
			part(par, "RoadPost", V(0.6, 5, 0.6), CF(c0 + side + V(0, 2.5, 0)), Color3.fromRGB(60, 60, 60), Mat.Metal)
		end
	end
end

---------------------------------------------------------------- BUILD
function W.Build()
	local world = Instance.new("Folder") world.Name = "World" world.Parent = workspace
	local result = {Stands = {}, Barriers = {}, AreaSpawns = {}, EnemySpawns = {}, Prompts = {}}

	-- ocean so the islands feel like a world
	Terrain:FillBlock(CF(0, -6, 0), V(2400, 8, 2400), Mat.Water)

	-- spawn location
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation" spawn.Anchored = true spawn.Size = V(12, 1, 12) spawn.CFrame = CF(0, 0.6, 30)
	spawn.Transparency = 1 spawn.CanCollide = false spawn.Neutral = true spawn.Duration = 0 spawn.Parent = workspace
	result.SpawnCF = CF(0, 4, 30)

	local spawnFolder = Instance.new("Folder") spawnFolder.Name = "Spawn" spawnFolder.Parent = world
	result.Stands = buildSpawn(spawnFolder)
	task.wait()

	local roads = Instance.new("Folder") roads.Name = "Roads" roads.Parent = world
	for i = 1, 10 do
		local c = Config.AreaCenter(i)
		local dirToSpawn = (-c).Unit
		local par = Instance.new("Folder") par.Name = "Area" .. i par.Parent = world
		local ed = dirToSpawn -- entrance direction (from area centre toward spawn)
		-- road from spawn plaza to area gate
		local gatePos = c + ed * (Config.World.AreaRadius - 12)
		makeRoad(roads, dirToSpawn * -1 * 0 + (c.Unit * (Config.World.SpawnRadius - 5)), gatePos, 18)
		task.wait()
		AreaBuild[i](c, par, ed)
		-- gate
		local theme = Config.Areas[i].theme
		local gcf = CF(gatePos + V(0, 0, 0), gatePos + dirToSpawn * 50)
		K.arch(par, gcf, 30, 28, theme.c1, theme.mat, theme.glow)
		local barrier = part(par, "Barrier", V(30, 26, 2), gcf * CF(0, 13, 0), theme.glow, Mat.ForceField, nil, true)
		barrier.Transparency = 0.15
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Unlock " .. Config.Areas[i].name
		prompt.ObjectText = "🪙 " .. Config.Format(Config.Areas[i].cost)
		prompt.HoldDuration = 0.3 prompt.MaxActivationDistance = 22 prompt.RequiresLineOfSight = false
		prompt.Parent = barrier
		barrier:SetAttribute("Area", i)
		-- sign
		local sg = part(par, "GateSign", V(1, 1, 1), gcf * CF(0, 40, 0), Color3.new(1, 1, 1), Mat.SmoothPlastic, nil, false)
		sg.Transparency = 1
		local gui = Instance.new("BillboardGui") gui.Size = UDim2.fromOffset(340, 80) gui.MaxDistance = 400 gui.Adornee = sg gui.Parent = sg
		local lb = Instance.new("TextLabel") lb.BackgroundTransparency = 1 lb.Size = UDim2.fromScale(1, 1) lb.Font = Enum.Font.FredokaOne lb.TextScaled = true
		lb.TextColor3 = theme.glow lb.TextStrokeTransparency = 0 lb.Text = Config.Areas[i].name lb.Parent = gui
		if i == 1 then barrier.CanCollide = false barrier.Transparency = 1 prompt.Enabled = false end
		result.Barriers[i] = barrier
		result.Prompts[i] = prompt
		result.AreaSpawns[i] = CF(gatePos - ed * 28 + V(0, 5, 0), gatePos - ed * 28 + V(0, 5, 0) + dirToSpawn * -50)
		-- enemy spawn points (ring spread)
		local list = {}
		local def = Config.Areas[i].enemies
		local placed = {}
		for k = 1, 16 do
			local tier = (k == 1) and 4 or ((k <= 5) and 3 or ((k <= 10) and 2 or 1))
			for tries = 1, 25 do
				local a = rng:NextNumber(0, 6.283) local r = rng:NextNumber(45, 185)
				local p = c + V(math.cos(a) * r, 0, math.sin(a) * r)
				local ok = (p - c).Unit:Dot(ed) < 0.9 or r < 100
				for _, q in ipairs(placed) do if (q - p).Magnitude < 28 then ok = false break end end
				if ok then
					placed[#placed + 1] = p
					p = V(p.X, groundY(p.X, p.Z), p.Z)
					list[#list + 1] = {pos = p, tier = tier, def = def[tier], face = (c - p).Unit}
					break
				end
			end
		end
		result.EnemySpawns[i] = list
		task.wait()
	end
	-- dock the decoration lights: make sure area 6 spawn is inside the dome
	return result
end

return W
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX18"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX17"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX8"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Client (LocalScript) | StarterPlayer.StarterPlayerScripts.Client
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local S = require(script:WaitForChild("Shared"))
local UI = require(script:WaitForChild("UI"))
require(script:WaitForChild("Pets"))
require(script:WaitForChild("WorldClient"))
require(script:WaitForChild("Hatch"))
local Starter = require(script:WaitForChild("Starter"))
require(script:WaitForChild("Ride"))

local camera = workspace.CurrentCamera

-- camera shake (stomps, hatches, titanic announcements)
RunService:BindToRenderStep("BBShake", Enum.RenderPriority.Camera.Value + 5, function(dt)
	local a = S.shakeAmp
	if a > 0.01 then
		camera.CFrame = camera.CFrame * CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0) * CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)
		S.shakeAmp = a * math.exp(-dt * 5)
	else
		S.shakeAmp = 0
	end
end)

-- optional background music (set Config.MusicId)
local music
if S.Config.MusicId ~= "" then
	music = Instance.new("Sound")
	music.SoundId = S.Config.MusicId
	music.Looped = true
	music.Volume = 0.25
	music.Parent = SoundService
	music:Play()
end
S.on("MusicVolume", function(v) if music then music.Volume = v * 0.5 end end)

local started = false
S.on("Data", function(d)
	if music then music.Volume = d.settings.music * 0.5 end
	if not started then
		started = true
		if not d.starter then Starter.run() end
	end
end)

-- the Data event may have fired before this script connected: ask for it until it arrives
task.spawn(function()
	local t = os.clock()
	while not S.data and os.clock() - t < 60 do
		S.invoke("RequestData")
		task.wait(1)
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Shared</string><ProtectedString name="Source"><![CDATA[-- Shared (ModuleScript) | StarterPlayerScripts.Client.Shared
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local S = {}
S.player = Players.LocalPlayer
S.Config = require(RS:WaitForChild("Config"))
S.MB = require(RS:WaitForChild("ModelBuilder"))
S.fmt = S.Config.Format
S.TS = TweenService
S.shakeAmp = 0
S.pal = {
	bg = Color3.fromRGB(26, 28, 50), panel = Color3.fromRGB(40, 45, 80), panel2 = Color3.fromRGB(55, 62, 108),
	acc = Color3.fromRGB(255, 200, 60), good = Color3.fromRGB(80, 210, 110), bad = Color3.fromRGB(235, 80, 80),
	blue = Color3.fromRGB(70, 140, 255), text = Color3.fromRGB(255, 255, 255), dim = Color3.fromRGB(170, 175, 205),
}

local Remotes = RS:WaitForChild("Remotes")
S.R = {}
for _, n in ipairs({"Data", "Notify", "PetHit", "Damage", "Defeated", "Coin", "Announce", "Fx", "Select"}) do
	S.R[n] = Remotes:WaitForChild(n)
end
local Act = Remotes:WaitForChild("Act")
function S.invoke(action, a, b)
	local ok, res = pcall(function() return Act:InvokeServer(action, a, b) end)
	if ok then return res end
	return nil
end

-- tiny signal bus
local listeners = {}
function S.on(name, fn)
	listeners[name] = listeners[name] or {}
	table.insert(listeners[name], fn)
end
function S.emit(name, ...)
	for _, fn in ipairs(listeners[name] or {}) do task.spawn(fn, ...) end
end

S.data = nil
S.R.Data.OnClientEvent:Connect(function(d)
	S.data = d
	S.emit("Data", d)
end)

---------------------------------------------------------------- ui helpers
function S.mk(class, props, kids)
	local o = Instance.new(class)
	local parent = props and props.Parent
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then o[k] = v end
	end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end
function S.round(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = o
	return c
end
function S.stroke(o, color, th)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = th or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = o
	return s
end
function S.label(parent, text, size, color, props)
	local p = {Parent = parent, BackgroundTransparency = 1, Text = text, TextColor3 = color or S.pal.text, Font = Enum.Font.FredokaOne, TextSize = size or 18, TextWrapped = true}
	for k, v in pairs(props or {}) do p[k] = v end
	local l = S.mk("TextLabel", p)
	return l
end
function S.button(parent, text, color, size, pos, cb, props)
	local p = {Parent = parent, Text = text, Size = size, Position = pos, BackgroundColor3 = color or S.pal.blue, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.FredokaOne, TextSize = 20, AutoButtonColor = true, TextWrapped = true}
	for k, v in pairs(props or {}) do p[k] = v end
	local b = S.mk("TextButton", p)
	S.round(b, 12)
	S.stroke(b, Color3.new(0, 0, 0), 2)
	local ts = Instance.new("UITextSizeConstraint") ts.MaxTextSize = p.TextSize ts.Parent = b
	b.MouseButton1Click:Connect(function()
		S.sfx("Click", 0.4)
		if cb then cb(b) end
	end)
	return b
end

function S.petName(name) return S.Config.Pets[name].display end
function S.rarityColor(name)
	return S.Config.Rarities[S.Config.Pets[name].rarity].color
end

-- static icon of a pet in a ViewportFrame
function S.petIcon(parent, name, props, dark)
	local vp = S.mk("ViewportFrame", {Parent = parent, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = dark and Color3.new(0, 0, 0) or Color3.fromRGB(170, 170, 185), LightColor = dark and Color3.new(0, 0, 0) or Color3.new(1, 1, 1), LightDirection = Vector3.new(-0.6, -0.8, -0.5)})
	for k, v in pairs(props or {}) do vp[k] = v end
	local rig = S.MB.Pet(name)
	rig.model.Parent = vp
	local cf, size = rig.model:GetBoundingBox()
	local r = math.max(size.X, size.Y, size.Z)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	local center = cf.Position
	local dist = r * 1.55
	cam.CFrame = CFrame.lookAt(center + Vector3.new(-0.8, 0.45, -1).Unit * dist, center)
	cam.Parent = vp
	vp.CurrentCamera = cam
	if dark then
		for _, p in ipairs(rig.model:GetDescendants()) do
			if p:IsA("BasePart") then p.Color = Color3.new(0, 0, 0) p.Material = Enum.Material.SmoothPlastic end
		end
	end
	return vp, rig, cam
end

---------------------------------------------------------------- sound + fx
local Terrain = workspace.Terrain
function S.sfx(key, vol, pitch, pos)
	local id = S.Config.Sounds[key]
	if not id then return end
	local snd = Instance.new("Sound")
	snd.SoundId = id
	snd.Volume = (vol or 0.6) * ((S.data and S.data.settings.sfx) or 0.8)
	snd.PlaybackSpeed = pitch or 1
	local holder
	if pos then
		holder = Instance.new("Attachment")
		holder.WorldPosition = pos
		holder.Parent = Terrain
		snd.RollOffMaxDistance = 220
		snd.RollOffMinDistance = 20
		snd.Parent = holder
	else
		snd.Parent = SoundService
	end
	snd:Play()
	Debris:AddItem(holder or snd, 6)
end

function S.burst(pos, color, count, size, speed, life)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = Terrain
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Lifetime = NumberRange.new((life or 0.6) * 0.7, life or 0.6)
	e.Speed = NumberRange.new((speed or 20) * 0.5, speed or 20)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 0.7
	e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size or 1), NumberSequenceKeypoint.new(1, 0)})
	e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
	e.Rate = 0
	e.Drag = 3
	e.Parent = a
	e:Emit(count or 15)
	Debris:AddItem(a, (life or 0.6) + 1)
end

function S.groundY(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return nil end
	local y = hrp.Position.Y - hum.HipHeight - hrp.Size.Y / 2
	if hum.RigType == Enum.HumanoidRigType.R6 then y = y - 2 end
	return y
end

return S
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- UI (ModuleScript) | StarterPlayerScripts.Client.UI
local S = require(script.Parent.Shared)
local Config, pal, mk, round, stroke, label, button = S.Config, S.pal, S.mk, S.round, S.stroke, S.label, S.button
local UIS = game:GetService("UserInputService")
local TS = S.TS
local UI = {}

local gui = mk("ScreenGui", {Name = "BeastboundUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5, Parent = S.player:WaitForChild("PlayerGui")})
local root = mk("Frame", {Name = "Root", BackgroundTransparency = 1, Parent = gui})
local uiscale = mk("UIScale", {Parent = root})
local function relayout()
	local vp = gui.AbsoluteSize
	if vp.X < 10 then return end
	local s = math.clamp(math.min(vp.X / 950, vp.Y / 520), 0.5, 1.6)
	uiscale.Scale = s
	root.Size = UDim2.fromOffset(vp.X / s, vp.Y / s)
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout)
relayout()
UI.gui, UI.root = gui, root
UI.touch = UIS.TouchEnabled

---------------------------------------------------------------- toasts
local toastList = mk("Frame", {Parent = root, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 62), Size = UDim2.fromOffset(420, 200), ZIndex = 50})
mk("UIListLayout", {Parent = toastList, Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center})
function UI.toast(text, kind)
	local c = kind == "good" and pal.good or (kind == "error" and pal.bad or pal.blue)
	local t = label(toastList, text, 18, Color3.new(1, 1, 1), {Size = UDim2.fromOffset(380, 30), BackgroundTransparency = 0.15, BackgroundColor3 = c})
	round(t, 10) stroke(t)
	task.delay(3, function()
		TS:Create(t, TweenInfo.new(0.4), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
		task.wait(0.45) t:Destroy()
	end)
end
S.R.Notify.OnClientEvent:Connect(UI.toast)

