local aScroll = mk("ScrollingFrame", {Parent = areasF, Position = UDim2.fromOffset(12, 94), Size = UDim2.fromOffset(536, 336), BackgroundColor3 = pal.bg, BackgroundTransparency = 0.3, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 11, BorderSizePixel = 0})
round(aScroll, 12)
