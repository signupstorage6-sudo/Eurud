}

---------------------------------------------------------------- PUBLIC: PETS
function M.Pet(name)
	local L = M.Looks[name]
	local b = newBuilder(name, L.s)
	if L.k == "biped" then biped(b, L) elseif L.k == "quad" then quad(b, L) else dragon(b, L) end
	local model = b.model
	model:SetAttribute("Kind", L.k)
	model:SetAttribute("Scale", L.s)
	model:SetAttribute("Titanic", L.titanic == true)
	if L.fx then aura(model, L.fx, L.titanic and 40 or 6, math.max(0.4, L.s * (L.titanic and 0.5 or 0.5)), 2) end
	if L.titanic then
		local pl = Instance.new("PointLight")
		pl.Color = L.glow or L.fx or Color3.new(1, 1, 1)
		pl.Range = 60
		pl.Brightness = 2
		pl.Parent = model.PrimaryPart
	end
	local rig = {model = model, joints = b.joints, base = {}, kind = L.k, phase = 0, scale = L.s, titanic = L.titanic == true}
	for n, j in pairs(b.joints) do rig.base[n] = j.C0 end
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then rig.has = true break end
	end
	rig.tails = 0
	while b.joints["Tail" .. (rig.tails + 1)] do rig.tails = rig.tails + 1 end
	return rig
end

-- procedural animation. speed = studs/s of the creature, flying = bool, attack = 0..1 lunge pulse
function M.Animate(rig, dt, speed, flying, attack)
	local j = rig.joints
	local T0 = os.clock()
	local moving = math.clamp(speed / 6, 0, 1)
	local heavy = rig.titanic and 0.45 or 1
	rig.phase = rig.phase + dt * (3 + speed * 0.45 * (rig.titanic and 0.22 or 0.6)) * (moving > 0.05 and 1 or 0)
	local ph = rig.phase
	local function set(n, cf) local m = j[n] if m then m.Transform = cf end end
	local sw = 0.7 * moving
	if rig.kind == "Dino" or rig.kind == "biped" then
		for _, s in ipairs({"L", "R"}) do
			local o = s == "L" and 0 or math.pi
			set("Thigh" .. s, A(math.sin(ph + o) * sw, 0, 0))
			set("Shin" .. s, A(math.max(0, -math.sin(ph + o + 0.8)) * 0.9 * moving, 0, 0))
			set("Arm" .. s, A(math.sin(ph * 0.5 + o) * 0.25 * moving + math.sin(os.clock() * 2) * 0.05, 0, 0))
		end
		set("Body", CF())
	end
	if rig.kind == "quad" then
		set("LegFL", A(math.sin(ph) * sw, 0, 0)) set("LegBR", A(math.sin(ph) * sw, 0, 0))
		set("LegFR", A(math.sin(ph + math.pi) * sw, 0, 0)) set("LegBL", A(math.sin(ph + math.pi) * sw, 0, 0))
	end
	local t = T0
	for i = 1, rig.tails do
		set("Tail" .. i, A(0, math.sin(t * 2 * heavy - i * 0.55) * (0.1 + 0.12 * moving), math.sin(t * 1.3 - i * 0.4) * 0.03))
	end
	local bob = math.sin(t * 1.6) * 0.04
	set("Neck", A(bob, math.sin(t * 0.9) * 0.05, 0))
	set("Neck2", A(bob, 0, 0))
	local jawOpen = 0.08 + math.max(0, math.sin(t * 0.7)) * 0.06 + (attack or 0) * 0.55
	set("Jaw", A(-jawOpen, 0, 0))
	set("Head", A((attack or 0) * 0.3, 0, 0))
	if j.WingL1 then
		local f = flying and 7 or (moving > 0.05 and 4.2 or 2.1) * heavy
		local amp = flying and 0.75 or 0.5
		for _, pre in ipairs({"Wing", "WingB"}) do
			for _, s in ipairs({-1, 1}) do
				local n = s < 0 and "L" or "R"
				local a = math.sin(t * f + (pre == "WingB" and 0.6 or 0)) * amp
				set(pre .. n .. "1", A(0, 0, s * a))
				set(pre .. n .. "2", A(0, 0, s * math.sin(t * f - 0.9) * amp * 0.6))
			end
		end
		set("ThighL", A(0.3 + math.sin(t * 2) * 0.05, 0, 0)) set("ThighR", A(0.3 + math.sin(t * 2) * 0.05, 0, 0))
		set("ShinL", A(-0.4, 0, 0)) set("ShinR", A(-0.4, 0, 0))
	end
	local halo = j.Halo
	if halo then halo.Transform = A(0, math.rad(t * 60 % 360), 0) end
	for i = 1, 8 do
		local o = j["Orb" .. i]
		if o then o.Transform = CF(0, math.sin(t * 2 + i) * 0.4 * rig.scale, 0) end
	end
end

---------------------------------------------------------------- PUBLIC: ENEMIES (anchored, no joints)
local function ep(model, name, size, cf, color, mat, kind, collide)
	local p = newPart(model, name, size, color, mat, kind or "Block")
	p.Anchored = true
	p.CFrame = cf
	p.CanQuery = true
	p.CanCollide = collide == true
	p.Massless = false
	return p
end

function M.Enemy(arch, theme, scale, name, boss)
	local model = Instance.new("Model")
	model.Name = name
	local S = scale
	local c1, c2, mat, glow = theme.c1, theme.c2, theme.mat, theme.glow
	local base = CF(0, 0, 0)
	local function P(n, size, pos, color, m, kind, rot)
		local cf = base * CF(pos * S) * (rot or CF())
		return ep(model, n, size * S, cf, color or c1, m or mat, kind or "Block")
	end
	local height
	local root
	if arch == "Golem" or arch == "Boss" then
		root = P("Root", V(3.2, 3.4, 2.4), V(0, 4.2, 0), c1, mat, "Block")
		root.CanCollide = true
		P("Core", V(1.2, 1.2, 0.5), V(0, 4.4, -1.2), glow, Enum.Material.Neon, "Ball")
		P("Head", V(1.7, 1.6, 1.7), V(0, 6.6, -0.1), c1, mat, "Block")
		P("EyeL", V(0.3, 0.25, 0.2), V(-0.4, 6.7, -1.0), glow, Enum.Material.Neon, "Block")
		P("EyeR", V(0.3, 0.25, 0.2), V(0.4, 6.7, -1.0), glow, Enum.Material.Neon, "Block")
		for _, s in ipairs({-1, 1}) do
			P("Arm" .. s, V(1.1, 3.4, 1.2), V(s * 2.3, 4.0, 0), c1, mat, "Block")
			P("Fist" .. s, V(1.5, 1.4, 1.5), V(s * 2.3, 2.0, -0.2), c2, mat, "Block")
			P("Leg" .. s, V(1.3, 2.4, 1.5), V(s * 0.9, 1.2, 0), c1, mat, "Block")
			P("Shoulder" .. s, V(1.5, 0.9, 1.6), V(s * 2.2, 6.0, 0), c2, mat, "Ball")
			P("Spike" .. s, V(0.4, 1.4, 0.4), V(s * 2.2, 6.8, 0), glow, Enum.Material.Neon, "Ball", CF() * A(0, 0, s * 0.3))
		end
		if arch == "Boss" or boss then
			for i = 1, 5 do
				P("Crown" .. i, V(0.3, 1.1, 0.3), V((i - 3) * 0.45, 7.8, 0), glow, Enum.Material.Neon, "Ball", A(0, 0, (i - 3) * 0.15))
			end
			P("Cape", V(3.6, 4.2, 0.2), V(0, 4.2, 1.4), c2, Enum.Material.Fabric, "Block")
		end
		height = 8.6
	elseif arch == "Beast" then
		root = P("Root", V(3.4, 2.6, 5.2), V(0, 3.0, 0), c1, mat, "Ball")
		root.CanCollide = true
		P("Head", V(2.0, 1.8, 2.2), V(0, 3.4, -3.2), c1, mat, "Ball")
		P("Snout", V(1.3, 1.0, 1.4), V(0, 3.0, -4.3), c2, mat, "Ball")
		P("EyeL", V(0.3, 0.3, 0.3), V(-0.7, 3.9, -4.0), glow, Enum.Material.Neon, "Ball")
		P("EyeR", V(0.3, 0.3, 0.3), V(0.7, 3.9, -4.0), glow, Enum.Material.Neon, "Ball")
		for _, s in ipairs({-1, 1}) do
			P("Horn" .. s, V(0.4, 1.9, 0.4), V(s * 0.8, 4.8, -3.0), c2, mat, "Ball", A(-0.4, 0, s * -0.4))
			P("Tusk" .. s, V(0.25, 1.3, 0.25), V(s * 0.6, 2.4, -4.6), WHITE, Enum.Material.SmoothPlastic, "Ball", A(0.5, 0, 0))
			for _, z in ipairs({-1.6, 1.6}) do
				P("Leg" .. s .. z, V(0.9, 2.4, 1.0), V(s * 1.3, 1.1, z), c1, mat, "Block")
			end
		end
		for i = 1, 5 do
			P("Spine" .. i, V(0.3, 1.0, 0.5), V(0, 4.6, -2 + i * 0.9), glow, Enum.Material.Neon, "Ball")
		end
		P("Tail", V(0.9, 0.9, 2.8), V(0, 3.2, 3.8), c1, mat, "Ball", A(-0.3, 0, 0))
		height = 6.2
	else -- Elemental
		root = P("Root", V(3.4, 3.4, 3.4), V(0, 5.0, 0), glow, Enum.Material.Neon, "Ball")
		root.CanCollide = true
		P("Shell", V(4.4, 4.4, 4.4), V(0, 5.0, 0), c1, Enum.Material.Glass, "Ball").Transparency = 0.45
		P("Base", V(2.4, 3.2, 2.4), V(0, 1.6, 0), c1, mat, "Ball")
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			P("Shard" .. i, V(0.7, 2.2, 0.7), V(math.cos(a) * 3.4, 5 + math.sin(a * 2) * 0.8, math.sin(a) * 3.4), c2, Enum.Material.Neon, "Ball", A(0, a, 0.5))
		end
		height = 8
	end
	model.PrimaryPart = root
	root.PivotOffset = CF(0, -root.Position.Y, 0)
	model:SetAttribute("Height", height * S)
	model:SetAttribute("Radius", 4 * S)
	return model
end

return M
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX16"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX14"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- GameServer (Script) | ServerScriptService.GameServer
-- Server-authoritative: data, hatching, combat, coins, areas, riding.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local DSS = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

Players.CharacterAutoLoads = false

local Config = require(RS:WaitForChild("Config"))
local MB = require(RS:WaitForChild("ModelBuilder"))
local WorldBuilder = require(script.Parent:WaitForChild("WorldBuilder"))

---------------------------------------------------------------- remotes
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
Remotes.Parent = RS
local E = {}
for _, n in ipairs({"Data", "Notify", "PetHit", "Damage", "Defeated", "Coin", "Announce", "Fx", "Select"}) do
	local r = Instance.new("RemoteEvent")
	r.Name = n
	r.Parent = Remotes
	E[n] = r
end
local Act = Instance.new("RemoteFunction")
Act.Name = "Act"
Act.Parent = Remotes

---------------------------------------------------------------- data
local store = DSS:GetDataStore("BeastboundV1")
local S = {} -- [player] = state
local rng = Random.new()

local function defaultData()
	return {coins = 0, starter = false, owned = {}, equipped = {}, areas = {["1"] = true}, discovered = {}, settings = {music = 0.5, sfx = 0.8}, v = 1}
end

local function sanitize(d)
	local def = defaultData()
	for k, v in pairs(def) do if d[k] == nil then d[k] = v end end
	d.settings.music = d.settings.music or 0.5
	d.settings.sfx = d.settings.sfx or 0.8
	for name, n in pairs(d.owned) do if not Config.Pets[name] or type(n) ~= "number" or n <= 0 then d.owned[name] = nil end end
	local eq = {}
	local used = {}
	for _, name in ipairs(d.equipped) do
		if d.owned[name] and (used[name] or 0) < d.owned[name] and #eq < Config.MaxEquipped then
			used[name] = (used[name] or 0) + 1
			eq[#eq + 1] = name
		end
	end
	d.equipped = eq
	return d
end

local function loadData(player)
	local key = "P_" .. player.UserId
	for i = 1, 5 do
		local ok, res = pcall(function() return store:GetAsync(key) end)
		if ok then
			if res then return sanitize(res), true end
			return defaultData(), true
		end
		warn("[Beastbound] load failed, retry", i, res)
		task.wait(1.5 * i)
	end
	return nil, false
end

local function saveData(player, final)
	local st = S[player]
	if not st or not st.canSave then return end
	local key = "P_" .. player.UserId
	for i = 1, 4 do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function() return st.data end)
		end)
		if ok then st.dirty = false return true end
		warn("[Beastbound] save failed, retry", i, err)
		task.wait(1.5 * i)
	end
	return false
end

local function push(player)
	local st = S[player]
	if st then E.Data:FireClient(player, st.data) end
end
local function queuePush(player)
	local st = S[player]
	if not st or st.pushing then return end
	st.pushing = true
	task.delay(0.12, function()
		st.pushing = false
		if player.Parent then push(player) end
	end)
end
local function notify(player, text, kind) E.Notify:FireClient(player, text, kind or "info") end

local function applyEquippedAttr(player)
	local st = S[player]
	player:SetAttribute("Equipped", table.concat(st.data.equipped, ","))
end

---------------------------------------------------------------- world + enemies
local worldReady = false
local world
local Enemies = {}
local enemiesFolder = Instance.new("Folder")
enemiesFolder.Name = "Enemies"
enemiesFolder.Parent = workspace

local function updateBar(model, d)
	local bar = model.PrimaryPart and model.PrimaryPart:FindFirstChild("Bar")
	if not bar then return end
	local f = math.clamp(d.hp / d.max, 0, 1)
	bar.Back.Fill.Size = UDim2.fromScale(f, 1)
	bar.Back.HP.Text = Config.Format(math.max(d.hp, 0)) .. " / " .. Config.Format(d.max)
end

local spawnEnemy
spawnEnemy = function(spec, areaIdx)
	local area = Config.Areas[areaIdx]
	local def = spec.def
	local scales = {1, 1.3, 1.7, 2.6}
	local model = MB.Enemy(def[2], area.theme, scales[spec.tier], def[1], spec.tier == 4)
	local root = model.PrimaryPart
	-- health bar (built at origin so we can read the offset)
	local g = Instance.new("BillboardGui")
	g.Name = "Bar"
	g.Adornee = root
	g.Size = UDim2.fromOffset(190, 52)
	g.StudsOffsetWorldSpace = Vector3.new(0, model:GetAttribute("Height") - root.Position.Y + 3, 0)
	g.MaxDistance = 160
	g.Parent = root
	local nm = Instance.new("TextLabel")
	nm.BackgroundTransparency = 1 nm.Size = UDim2.new(1, 0, 0.45, 0) nm.Font = Enum.Font.FredokaOne nm.TextScaled = true
	nm.TextColor3 = spec.tier == 4 and Color3.fromRGB(255, 120, 120) or Color3.new(1, 1, 1) nm.TextStrokeTransparency = 0
	nm.Text = def[1] nm.Parent = g
	local back = Instance.new("Frame")
	back.Name = "Back" back.Position = UDim2.fromScale(0.05, 0.5) back.Size = UDim2.fromScale(0.9, 0.45) back.BackgroundColor3 = Color3.fromRGB(30, 30, 40) back.BorderSizePixel = 0 back.Parent = g
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 8)
	local st = Instance.new("UIStroke", back) st.Thickness = 2 st.Color = Color3.new(0, 0, 0)
	local fill = Instance.new("Frame")
	fill.Name = "Fill" fill.Size = UDim2.fromScale(1, 1) fill.BackgroundColor3 = spec.tier == 4 and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(90, 230, 90) fill.BorderSizePixel = 0 fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 8)
	local hp = Instance.new("TextLabel")
	hp.Name = "HP" hp.BackgroundTransparency = 1 hp.Size = UDim2.fromScale(1, 1) hp.Font = Enum.Font.GothamBold hp.TextScaled = true
	hp.TextColor3 = Color3.new(1, 1, 1) hp.TextStrokeTransparency = 0.3 hp.ZIndex = 3 hp.Parent = back

	local mult = Config.TierMult[spec.tier]
	local d = {hp = area.hp * mult, max = area.hp * mult, area = areaIdx, reward = area.reward * mult, tier = spec.tier, contrib = {}, alive = true}
	Enemies[model] = d
	model:SetAttribute("Area", areaIdx)
	model:SetAttribute("Tier", spec.tier)
	model:SetAttribute("EnemyName", def[1])
	CollectionService:AddTag(model, "Enemy")
	updateBar(model, d)
	local face = spec.face
	model:PivotTo(CFrame.lookAt(spec.pos, spec.pos + Vector3.new(face.X, 0, face.Z)))
	model.Parent = enemiesFolder
	d.spec = spec
	return model
end

local function defeat(model)
	local d = Enemies[model]
	if not d or not d.alive then return end
	d.alive = false
	model:SetAttribute("Dead", true)
	local bar = model.PrimaryPart:FindFirstChild("Bar")
	if bar then bar.Enabled = false end
	local pos = model:GetPivot().Position + Vector3.new(0, 4, 0)
	E.Defeated:FireAllClients(model)
	local total = 0
	for p, dmg in pairs(d.contrib) do if p.Parent then total = total + dmg end end
	for p, dmg in pairs(d.contrib) do
		local st = S[p]
		if st and p.Parent and total > 0 then
			local amount = math.max(1, math.floor(d.reward * (dmg / total)))
			st.data.coins = st.data.coins + amount
			E.Coin:FireClient(p, pos, amount)
			queuePush(p)
		end
	end
	for p, s in pairs(S) do
		local tv = p:FindFirstChild("Target")
		if tv and tv.Value == model then tv.Value = nil end
	end
	local spec, area = d.spec, d.area
	task.delay(2.4, function()
		Enemies[model] = nil
		model:Destroy()
	end)
	task.delay(Config.TierRespawn[d.tier], function()
		if world then spawnEnemy(spec, area) end
	end)
end

local function damageEnemy(player, model, amount)
	local d = Enemies[model]
	if not d or not d.alive then return end
	d.hp = d.hp - amount
	d.contrib[player] = (d.contrib[player] or 0) + amount
	updateBar(model, d)
	if d.hp <= 0 then defeat(model) end
end

-- combat loop
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc = acc + dt
	if acc < 0.1 then return end
	acc = 0
	local now = os.clock()
	for player, st in pairs(S) do
		local tv = player:FindFirstChild("Target")
		local enemy = tv and tv.Value
		if enemy then
			local d = Enemies[enemy]
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not d or not d.alive or not hrp or not enemy.Parent or (hrp.Position - enemy:GetPivot().Position).Magnitude > Config.AttackRange then
				tv.Value = nil
			else
				for i, name in ipairs(st.data.equipped) do
					local nh = st.nextHit[i]
					if not nh then
						st.nextHit[i] = now + (i - 1) * 0.25 + 0.5
					elseif now >= nh then
						st.nextHit[i] = now + Config.HitInterval
						local dmg = Config.GetDamage(name)
						E.PetHit:FireAllClients(player, i, enemy, dmg)
						E.Damage:FireClient(player, enemy, dmg)
						damageEnemy(player, enemy, dmg)
						if not d.alive then break end
					end
				end
			end
		end
	end
end)

---------------------------------------------------------------- actions
local function areaUnlocked(st, i) return st.data.areas[tostring(i)] == true end

local function unlockArea(player, i)
	local st = S[player]
	if not st or type(i) ~= "number" then return false end
	i = math.floor(i)
	local area = Config.Areas[i]
	if not area or areaUnlocked(st, i) then return false end
	if i > 1 and not areaUnlocked(st, i - 1) then notify(player, "Unlock the previous area first!", "error") return false end
	if st.data.coins < area.cost then notify(player, "Not enough coins! Need " .. Config.Format(area.cost), "error") return false end
	st.data.coins = st.data.coins - area.cost
	st.data.areas[tostring(i)] = true
	notify(player, area.name .. " unlocked! New egg available at spawn!", "good")
	E.Fx:FireClient(player, "AreaUnlock", i)
	push(player)
	task.spawn(saveData, player)
	return true
end

local function roll(egg)
	local total = 0
	for _, o in ipairs(egg.odds) do total = total + o[2] end
	local r = rng:NextNumber() * total
	local acc2 = 0
	for _, o in ipairs(egg.odds) do
		acc2 = acc2 + o[2]
		if r <= acc2 then return o[1] end
	end
	return egg.odds[1][1]
end

local function hatch(player, eggId, count)
	local st = S[player]
	if not st or not st.data.starter then return {ok = false, err = "Pick a starter first"} end
	local egg = Config.Eggs[tostring(eggId)]
	if not egg then return {ok = false, err = "Unknown egg"} end
	if count ~= 1 and count ~= 3 and count ~= 8 then count = 1 end
	if not areaUnlocked(st, egg.area) then return {ok = false, err = "Area not unlocked"} end
	local now = os.clock()
	if st.lastHatch and now - st.lastHatch < 0.6 then return {ok = false, err = "Slow down"} end
	local stand = world and world.Stands[egg.id]
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not stand or not hrp or (hrp.Position - stand.PrimaryPart.Position).Magnitude > 45 then return {ok = false, err = "Stand next to the egg"} end
	local cost = egg.price * count
	if st.data.coins < cost then return {ok = false, err = "Not enough coins"} end
	st.lastHatch = now
	st.data.coins = st.data.coins - cost
	local results = {}
	for i = 1, count do
		local name = roll(egg)
		results[i] = name
		st.data.owned[name] = (st.data.owned[name] or 0) + 1
		st.data.discovered[name] = true
		local pet = Config.Pets[name]
		if pet.titanic then
			task.delay(5.5, function() E.Announce:FireAllClients("Titanic", player.Name, pet.display, name) end)
		elseif Config.Rarities[pet.rarity].order >= 6 then
			task.delay(4.5, function() E.Announce:FireAllClients("Rare", player.Name, pet.display, pet.rarity) end)
		end
	end
	-- auto-equip the first pets if there is room
	if #st.data.equipped < Config.MaxEquipped then
		for _, name in ipairs(results) do
			if #st.data.equipped < Config.MaxEquipped then st.data.equipped[#st.data.equipped + 1] = name end
		end
		applyEquippedAttr(player)
	end
	push(player)
	task.spawn(saveData, player)
	return {ok = true, results = results}
end

local function countEq(eq, name)
	local n = 0
	for _, v in ipairs(eq) do if v == name then n = n + 1 end end
	return n
end

local function setEq(player, newEq)
	local st = S[player]
	st.data.equipped = newEq
	st.nextHit = {}
	applyEquippedAttr(player)
	push(player)
end

local handlers = {}

handlers.ChooseStarter = function(player, kind)
	local st = S[player]
	if st.data.starter then return false end
	local name = kind == "Dragon" and "StarterDragon" or (kind == "Dino" and "StarterDino" or nil)
	if not name then return false end
	st.data.starter = name
	st.data.owned[name] = 1
	st.data.discovered[name] = true
	st.data.equipped = {name}
	applyEquippedAttr(player)
	push(player)
	task.spawn(saveData, player)
	return true
end

handlers.RequestData = function(player) push(player) return true end

handlers.Hatch = function(player, eggId, count) return hatch(player, eggId, count) end

handlers.Equip = function(player, name)
	local st = S[player]
	if type(name) ~= "string" or not st.data.owned[name] then return false end
	local eq = st.data.equipped
	if #eq >= Config.MaxEquipped or countEq(eq, name) >= st.data.owned[name] then return false end
	eq[#eq + 1] = name
	setEq(player, eq)
	return true
end

handlers.Unequip = function(player, idx)
	local st = S[player]
	if type(idx) ~= "number" or not st.data.equipped[idx] then return false end
	table.remove(st.data.equipped, idx)
	setEq(player, st.data.equipped)
	return true
end

handlers.UnequipAll = function(player)
	setEq(player, {})
	return true
end

handlers.EquipBest = function(player)
	local st = S[player]
	local list = {}
	for name, n in pairs(st.data.owned) do
		for _ = 1, n do list[#list + 1] = name end
	end
	table.sort(list, function(a, b) return Config.Pets[a].dmg > Config.Pets[b].dmg end)
	local eq = {}
	for i = 1, math.min(Config.MaxEquipped, #list) do eq[i] = list[i] end
	setEq(player, eq)
	return true
end

handlers.UnlockArea = function(player, i) return unlockArea(player, i) end

handlers.Teleport = function(player, i)
	local st = S[player]
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or type(i) ~= "number" then return false end
	player:SetAttribute("Riding", nil)
	if i == 0 then
		hrp.CFrame = world.SpawnCF
		return true
	end
	if not areaUnlocked(st, i) or not world.AreaSpawns[i] then return false end
	hrp.CFrame = world.AreaSpawns[i]
	return true
end

handlers.Ride = function(player, name)
	local st = S[player]
	if name == nil or name == "" then player:SetAttribute("Riding", nil) return true end
	local pet = type(name) == "string" and Config.Pets[name]
	if not pet or not pet.titanic or not st.data.owned[name] then return false end
	player:SetAttribute("Riding", name)
	return true
end

handlers.SetSetting = function(player, key, value)
	local st = S[player]
	if (key == "music" or key == "sfx") and type(value) == "number" then
		st.data.settings[key] = math.clamp(value, 0, 1)
		return true
	end
	return false
end

Act.OnServerInvoke = function(player, action, a, b)
	local st = S[player]
	if not st or type(action) ~= "string" or not handlers[action] then return false end
	local ok, res = pcall(handlers[action], player, a, b)
	if not ok then warn("[Beastbound] action error", action, res) return false end
	return res
end

E.Select.OnServerEvent:Connect(function(player, model)
	local st = S[player]
	local tv = player:FindFirstChild("Target")
	if not st or not tv then return end
	if model == nil then tv.Value = nil return end
	if typeof(model) ~= "Instance" then return end
	local d = Enemies[model]
	if not d or not d.alive or not areaUnlocked(st, d.area) then return end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or (hrp.Position - model:GetPivot().Position).Magnitude > Config.AttackRange + 60 then return end
	tv.Value = model
	st.nextHit = {}
end)

---------------------------------------------------------------- players
local function setupCharacter(player, char)
	local hum = char:WaitForChild("Humanoid")
	hum.WalkSpeed = 22
	player:SetAttribute("Riding", nil)
	hum.Died:Connect(function()
		local tv = player:FindFirstChild("Target")
		if tv then tv.Value = nil end
		task.delay(3, function()
			if player.Parent then player:LoadCharacter() end
		end)
	end)
end

local started = {}
local function onPlayer(player)
	if started[player] then return end
	started[player] = true
	local tv = Instance.new("ObjectValue")
	tv.Name = "Target"
	tv.Parent = player
	while not worldReady do task.wait(0.25) end
	local data, ok = loadData(player)
	local canSave = true
	if not ok then
		if RunService:IsStudio() then
			data = defaultData()
			canSave = false
			warn("[Beastbound] Studio without DataStore access: progress will NOT be saved this session.")
		else
			player:Kick("Could not load your save. Please rejoin - your progress is safe.")
			return
		end
	end
	S[player] = {data = data, canSave = canSave, nextHit = {}}
	player:SetAttribute("Equipped", table.concat(data.equipped, ","))
	player:SetAttribute("Ready", true)
	player.CharacterAdded:Connect(function(c) setupCharacter(player, c) end)
	push(player)
	player:LoadCharacter()
end

Players.PlayerAdded:Connect(onPlayer)
Players.PlayerRemoving:Connect(function(player)
	saveData(player, true)
	S[player] = nil
	started[player] = nil
end)

task.spawn(function()
	while true do
		task.wait(60)
		for player in pairs(S) do task.spawn(saveData, player) end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() then return end
	local pending = 0
	for player in pairs(S) do
		pending = pending + 1
		task.spawn(function() saveData(player, true) pending = pending - 1 end)
	end
	local t = os.clock()
	while pending > 0 and os.clock() - t < 25 do task.wait(0.2) end
end)

---------------------------------------------------------------- build the world, then enemies
world = WorldBuilder.Build()
for i, prompt in pairs(world.Prompts) do
	prompt.Triggered:Connect(function(player) unlockArea(player, i) end)
end
for i, list in pairs(world.EnemySpawns) do
	for _, spec in ipairs(list) do spawnEnemy(spec, i) end
end
worldReady = true
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, p) end
print("[Beastbound] world ready")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- WorldBuilder (ModuleScript) | ServerScriptService.WorldBuilder
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS:WaitForChild("Config"))
local W = {}
local Terrain = workspace.Terrain
local rng = Random.new(2024)
local V, CF, A = Vector3.new, CFrame.new, CFrame.Angles
local Mat = Enum.Material
local count = 0

local function tick()
	count = count + 1
	if count % 120 == 0 then task.wait() end
end

local function part(par, name, size, cf, color, mat, shape, collide)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Mat.SmoothPlastic
	p.CanCollide = collide ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Ball" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif shape == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = par
	tick()
	return p
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = {Terrain}
local function groundY(x, z)
	local r = workspace:Raycast(V(x, 160, z), V(0, -320, 0), rayParams)
	return r and r.Position.Y or 0
end

local function pick(t) return t[rng:NextInteger(1, #t)] end
local function rc(c, v) -- jitter colour
	v = v or 0.08
	local h, s, val = c:ToHSV()
	return Color3.fromHSV(h, s, math.clamp(val + rng:NextNumber(-v, v), 0, 1))
end

---------------------------------------------------------------- decoration kits
local K = {}

function K.pine(par, pos, s, leaf, snow)
	local m = Instance.new("Model") m.Name = "Pine" m.Parent = par
	local h = 14 * s
	part(m, "Trunk", V(1.4 * s, h, 1.4 * s), CF(pos + V(0, h / 2, 0)), Color3.fromRGB(95, 65, 40), Mat.Wood)
	for i = 1, 4 do
		local w = (11 - i * 2.2) * s
		part(m, "L" .. i, V(w, 4 * s, w), CF(pos + V(0, h * 0.4 + i * 3.2 * s, 0)), rc(leaf), Mat.Grass, "Ball", false)
		if snow then part(m, "S" .. i, V(w * 0.8, 1.6 * s, w * 0.8), CF(pos + V(0, h * 0.4 + i * 3.2 * s + 1.4 * s, 0)), Color3.fromRGB(245, 250, 255), Mat.Snow, "Ball", false) end
	end
end

function K.oak(par, pos, s, leaf)
	local m = Instance.new("Model") m.Name = "Tree" m.Parent = par
	part(m, "Trunk", V(2 * s, 9 * s, 2 * s), CF(pos + V(0, 4.5 * s, 0)), Color3.fromRGB(110, 78, 50), Mat.Wood, "Cyl").CFrame = CF(pos + V(0, 4.5 * s, 0)) * A(0, 0, math.pi / 2)
	for i = 1, 4 do
		local o = V(rng:NextNumber(-3, 3) * s, 0, rng:NextNumber(-3, 3) * s)
		part(m, "Leaf" .. i, V(8 * s, 6 * s, 8 * s), CF(pos + V(0, 11 * s, 0) + o), rc(leaf), Mat.Grass, "Ball", false)
	end
end

function K.jungleTree(par, pos, s)
	local m = Instance.new("Model") m.Name = "JungleTree" m.Parent = par
	local h = 30 * s
	local lean = rng:NextNumber(-0.15, 0.15)
	local t = part(m, "Trunk", V(h, 3 * s, 3 * s), CF(pos + V(0, h / 2, 0)) * A(0, 0, math.pi / 2 + lean), Color3.fromRGB(90, 62, 40), Mat.Wood, "Cyl")
	local top = pos + V(-math.sin(lean) * h / 2 * -1, h, 0)
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		part(m, "Frond" .. i, V(16 * s, 1.2, 5 * s), CF(top + V(math.cos(a) * 6 * s, -1, math.sin(a) * 6 * s)) * A(0, -a, -0.35), rc(Color3.fromRGB(60, 150, 55)), Mat.Grass, "Ball", false)
	end
	for i = 1, 3 do
		part(m, "Vine" .. i, V(0.4, 14 * s, 0.4), CF(top + V(rng:NextNumber(-4, 4), -8 * s, rng:NextNumber(-4, 4))), Color3.fromRGB(50, 110, 40), Mat.Grass, nil, false)
	end
	part(m, "Canopy", V(14 * s, 7 * s, 14 * s), CF(top + V(0, 2 * s, 0)), rc(Color3.fromRGB(45, 120, 50)), Mat.Grass, "Ball", false)
end

function K.fern(par, pos, s)
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		part(par, "Fern", V(5 * s, 0.3, 1.4 * s), CF(pos + V(math.cos(a) * 2 * s, 1.2 * s, math.sin(a) * 2 * s)) * A(0, -a, 0.5), rc(Color3.fromRGB(70, 160, 60)), Mat.Grass, "Ball", false)
	end
end

function K.rock(par, pos, s, color, mat)
	local m = part(par, "Rock", V(rng:NextNumber(4, 8) * s, rng:NextNumber(3, 6) * s, rng:NextNumber(4, 8) * s), CF(pos + V(0, 1.2 * s, 0)) * A(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)), rc(color), mat or Mat.Slate, "Ball")
	return m
end

function K.crystal(par, pos, s, color, glass)
	local n = rng:NextInteger(2, 4)
	for i = 1, n do
		local h = rng:NextNumber(8, 20) * s
		part(par, "Crystal", V(2.4 * s, h, 2.4 * s), CF(pos + V(rng:NextNumber(-3, 3), h / 2 - 1, rng:NextNumber(-3, 3))) * A(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, 6), rng:NextNumber(-0.35, 0.35)), rc(color, 0.12), glass and Mat.Glass or Mat.Neon, "Ball", false).Transparency = glass and 0.25 or 0.1
	end
	local l = Instance.new("PointLight") l.Color = color l.Range = 22 l.Brightness = 1.2
	l.Parent = par:FindFirstChildWhichIsA("BasePart", true)
end

function K.iceSpike(par, pos, s)
	local h = rng:NextNumber(10, 26) * s
	part(par, "IceSpike", V(4 * s, h, 4 * s), CF(pos + V(0, h / 2 - 1, 0)) * A(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6), rng:NextNumber(-0.2, 0.2)), Color3.fromRGB(170, 225, 255), Mat.Ice, "Ball").Transparency = 0.15
end

function K.deadTree(par, pos, s, color)
	local m = Instance.new("Model") m.Name = "DeadTree" m.Parent = par
	local h = 18 * s
	part(m, "Trunk", V(h, 1.6 * s, 1.6 * s), CF(pos + V(0, h / 2, 0)) * A(0, 0, math.pi / 2 + rng:NextNumber(-0.2, 0.2)), color, Mat.Wood, "Cyl")
	for i = 1, 4 do
		local a = rng:NextNumber(0, 6.28)
		part(m, "Branch", V(9 * s, 0.7 * s, 0.7 * s), CF(pos + V(0, h * (0.45 + i * 0.12), 0)) * A(0, a, 0.7), color, Mat.Wood, "Cyl", false)
	end
end

function K.pillar(par, pos, h, color, mat, glow)
	part(par, "Pillar", V(4, h, 4), CF(pos + V(0, h / 2, 0)), color, mat, "Cyl").CFrame = CF(pos + V(0, h / 2, 0)) * A(0, 0, math.pi / 2)
	part(par, "Cap", V(5.6, 1.2, 5.6), CF(pos + V(0, h + 0.6, 0)), color, mat)
	part(par, "Base", V(5.6, 1.2, 5.6), CF(pos + V(0, 0.6, 0)), color, mat)
	if glow then part(par, "Rune", V(0.4, h * 0.6, 0.4), CF(pos + V(2.1, h * 0.5, 0)), glow, Mat.Neon, nil, false) end
end

function K.torch(par, pos, color)
	part(par, "TorchPole", V(0.8, 6, 0.8), CF(pos + V(0, 3, 0)), Color3.fromRGB(70, 55, 40), Mat.Wood)
	local b = part(par, "Brazier", V(2.6, 1.2, 2.6), CF(pos + V(0, 6.4, 0)), Color3.fromRGB(50, 50, 55), Mat.Metal, "Cyl", false)
	b.CFrame = CF(pos + V(0, 6.4, 0)) * A(0, 0, math.pi / 2)
	local f = Instance.new("Fire") f.Color = color f.SecondaryColor = Color3.new(1, 1, 1) f.Size = 5 f.Heat = 6 f.Parent = b
	local l = Instance.new("PointLight") l.Color = color l.Range = 24 l.Brightness = 1.5 l.Parent = b
end

function K.cloud(par, pos, s)
	local m = Instance.new("Model") m.Name = "Cloud" m.Parent = par
	for i = 1, 5 do
		part(m, "Puff", V(rng:NextNumber(14, 24) * s, rng:NextNumber(6, 10) * s, rng:NextNumber(14, 22) * s), CF(pos + V(rng:NextNumber(-12, 12) * s, rng:NextNumber(-2, 2), rng:NextNumber(-8, 8) * s)), Color3.fromRGB(255, 252, 255), Mat.SmoothPlastic, "Ball", false).Transparency = 0.12
	end
end

function K.skull(par, pos, s, color, rot)
	local m = Instance.new("Model") m.Name = "Skull" m.Parent = par
	local base = CF(pos) * A(0, rot or 0, 0)
	part(m, "Cranium", V(12 * s, 9 * s, 16 * s), base * CF(0, 5 * s, 0), color, Mat.Slate, "Ball")
	part(m, "Snout", V(8 * s, 5 * s, 12 * s), base * CF(0, 3 * s, -10 * s), color, Mat.Slate, "Ball")
	for _, sd in ipairs({-1, 1}) do
		part(m, "Socket", V(3 * s, 3 * s, 3 * s), base * CF(sd * 4 * s, 7 * s, -5.5 * s), Color3.fromRGB(15, 15, 20), Mat.SmoothPlastic, "Ball", false)
		part(m, "Horn", V(2 * s, 14 * s, 2 * s), base * CF(sd * 5 * s, 10 * s, 5 * s) * A(-0.5, 0, sd * -0.4), color, Mat.Slate, "Ball", false)
		for i = 1, 4 do part(m, "Tooth", V(1 * s, 3 * s, 1 * s), base * CF(sd * 2.5 * s, 0.5 * s, (-6 - i * 2) * s), Color3.fromRGB(235, 230, 215), Mat.Marble, "Ball", false) end
	end
end

function K.ribcage(par, pos, s, color, rot)
	local base = CF(pos) * A(0, rot or 0, 0)
	for i = 1, 6 do
		for _, sd in ipairs({-1, 1}) do
			for k = 1, 3 do
				local a = k / 3 * 1.2
				part(par, "Rib", V(1 * s, 6 * s, 1 * s), base * CF(sd * math.sin(a) * 6 * s, 5 * s + math.cos(a) * 5 * s, i * 4 * s) * A(0, 0, sd * -a), color, Mat.Marble, "Ball", false)
			end
		end
	end
	part(par, "Spine", V(2 * s, 2 * s, 28 * s), base * CF(0, 12 * s, 12 * s), color, Mat.Marble, "Ball", false)
end

function K.arch(par, cf, w, h, color, mat, glow)
	part(par, "ArchL", V(4, h, 4), cf * CF(-w / 2, h / 2, 0), color, mat)
	part(par, "ArchR", V(4, h, 4), cf * CF(w / 2, h / 2, 0), color, mat)
	part(par, "ArchTop", V(w + 8, 4, 5), cf * CF(0, h + 2, 0), color, mat)
	part(par, "ArchCrown", V(w * 0.6, 5, 6), cf * CF(0, h + 6, 0), color, mat, "Ball")
	if glow then
		part(par, "ArchGlow", V(w + 2, 1, 1), cf * CF(0, h - 0.5, -2.6), glow, Mat.Neon, nil, false)
	end
end

local function emitter(par, pos, size, color, rate, speed, life, lightEm, sz, dir)
	local p = part(par, "Atmos", size, CF(pos), Color3.new(1, 1, 1), Mat.SmoothPlastic, nil, false)
	p.Transparency = 1
	p.CanQuery = false
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = NumberRange.new(life, life * 1.6)
	e.Speed = NumberRange.new(speed, speed * 1.5)
	e.EmissionDirection = dir or Enum.NormalId.Bottom
	e.SpreadAngle = Vector2.new(30, 30)
	e.LightEmission = lightEm or 0.3
	e.Size = NumberSequence.new(sz or 0.6)
	e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1)})
	e.Shape = Enum.ParticleEmitterShape.Box
	e.Parent = p
	return p
end

---------------------------------------------------------------- area builders
local function scatter(c, rmin, rmax, n, fn, avoidEntrance, entranceDir)
	for i = 1, n do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(rmin, rmax)
		local p = c + V(math.cos(a) * r, 0, math.sin(a) * r)
		local ok = true
		if avoidEntrance then
			local d = (p - c)
			if d.Unit:Dot(entranceDir) > 0.93 and r > 120 then ok = false end
		end
		if ok then
			p = V(p.X, groundY(p.X, p.Z), p.Z)
			fn(p)
		end
	end
end

local function hills(c, mat, n, rmin, rmax, minR, maxR, yoff)
	for i = 1, n do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(rmin, rmax)
		Terrain:FillBall(c + V(math.cos(a) * r, yoff or 0, math.sin(a) * r), rng:NextNumber(minR, maxR), mat)
		if i % 6 == 0 then task.wait() end
	end
end

local AreaBuild = {}

AreaBuild[1] = function(c, par, ed)
	Terrain:FillCylinder(CF(c + V(0, -10, 0)), 20, 230, Mat.Grass)
	hills(c, Mat.Grass, 18, 40, 200, 14, 30, -8)
	hills(c, Mat.Ground, 6, 60, 190, 8, 14, -6)
	scatter(c, 20, 215, 45, function(p) K.oak(par, p, rng:NextNumber(0.9, 1.5), Color3.fromRGB(95, 170, 70)) end, true, ed)
	scatter(c, 20, 215, 40, function(p) K.rock(par, p, rng:NextNumber(0.8, 2), Color3.fromRGB(150, 140, 125), Mat.Slate) end)
	scatter(c, 30, 210, 40, function(p) for _ = 1, 3 do part(par, "Flower", V(1, 1, 1), CF(p + V(rng:NextNumber(-3, 3), 0.8, rng:NextNumber(-3, 3))), pick({Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 230, 90), Color3.fromRGB(180, 130, 255)}), Mat.SmoothPlastic, "Ball", false) end end)
	-- landmark: stone dino skeleton arch
	K.ribcage(par, c + V(0, 0, -30), 1.6, Color3.fromRGB(235, 228, 205), 0)
	K.skull(par, c + V(0, 0, -78), 1.3, Color3.fromRGB(235, 228, 205), 0)
	-- pond
	Terrain:FillCylinder(CF(c + V(90, -3, 60)), 8, 26, Mat.Water)
	emitter(par, c + V(0, 55, 0), V(380, 2, 380), Color3.fromRGB(255, 255, 220), 6, 1, 8, 0.6, 0.5)
end

