		local vc = c + V(math.cos(a) * 150, 0, math.sin(a) * 150)
		for k = 0, 6 do Terrain:FillCylinder(CF(vc + V(0, k * 7, 0)), 8, 44 - k * 5.5, Mat.Basalt) end
		emitter(par, vc + V(0, 52, 0), V(10, 2, 10), Color3.fromRGB(255, 130, 60), 60, 30, 2.4, 1, 1.2, Enum.NormalId.Top)
	end
	for i = 1, 16 do
